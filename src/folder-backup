# =============================================================================
# app_cmd_menu_language() - Language board under front 6
# =============================================================================
#
# 61 stores en. 62 stores zh-Hant. 63 stores es. 64 stores fr.
# 65 stores de. 66 stores zh-Hans. 67 stores ja. 68 stores ko.
# Each returns to the front board. 0 / empty / EOF is Back and does
# not write the file. The choice is a current-shell input builtin.
#
# ALIGNMENT:
# - requirement-shell-cli-language.md
# - requirement-shell-cli-default-interaction.md
# =============================================================================
app_cmd_menu_language() {
    while true; do
        app_menu_draw_on
        out_info "$(util_app_ident) — $(app_menu_text cat_language)"
        out_menu_choice 61 English "$(app_menu_text lang_en_long)"
        out_menu_choice 62 "繁體中文" "$(app_menu_text lang_zh_long)"
        out_menu_choice 63 "Español" "$(app_menu_text lang_es_long)"
        out_menu_choice 64 "Français" "$(app_menu_text lang_fr_long)"
        out_menu_choice 65 "Deutsch" "$(app_menu_text lang_de_long)"
        out_menu_choice 66 "简体中文" "$(app_menu_text lang_zh_hans_long)"
        out_menu_choice 67 "日本語" "$(app_menu_text lang_ja_long)"
        out_menu_choice 68 "한국어" "$(app_menu_text lang_ko_long)"
        out_menu_choice 0 "$(app_menu_text word_back)"
        out_msg_n "$(app_menu_text line_prompt)"
        if ! read -r _prompt_line; then
            _prompt_line=""
            unset _prompt_line
            return 0
        fi
        case "${_prompt_line}" in
            61|english|en|English)
                _ls_code=en
                ;;
            62|traditional-chinese|zh-hant|zh-Hant|繁體中文)
                _ls_code=zh-Hant
                ;;
            63|spanish|es|Español|español)
                _ls_code=es
                ;;
            64|french|fr|Français|français)
                _ls_code=fr
                ;;
            65|german|de|Deutsch|deutsch)
                _ls_code=de
                ;;
            66|simplified-chinese|zh-hans|zh-Hans|简体中文)
                _ls_code=zh-Hans
                ;;
            67|japanese|ja|日本語)
                _ls_code=ja
                ;;
            68|korean|ko|한국어)
                _ls_code=ko
                ;;
            0|back|Back|""|exit|quit|Exit|QUIT|q|Q|返回|Atrás|Retour|Zurück|戻る|뒤로)
                unset _prompt_line
                return 0
                ;;
            *)
                out_error "$(app_menu_text unknown_language "${_prompt_line}")"
                unset _prompt_line
                continue
                ;;
        esac
        if app_lang_save "${_ls_code}"; then
            out_info "$(app_menu_text lang_saved)"
        else
            out_warn "$(app_menu_text lang_save_fail)"
        fi
        unset _prompt_line _ls_code
        return 0
    done
}


# =============================================================================
# app_cmd_menu_sudoers() - Grant board under front 7
# =============================================================================
#
# Operational rows only: 72 submit, 75 remove. Test-purpose numbers
# 71, 73, and 74 stay reserved. 0 / empty / EOF / exit returns to
# the front. A leaf returns 2 so the front board redisplays.
# Copy follows APP_LANG. Leaf shorts stay the English verbs.
#
# ALIGNMENT:
# - requirement-shell-cli-sudoers-submenu.md
# - requirement-shell-cli-language.md
# =============================================================================
app_cmd_menu_sudoers() {
    _a="${1-}"
    while true; do
        app_menu_draw_on
        out_info "$(util_app_ident) — $(app_menu_text sudoers_header)"
        out_info "$(app_menu_text sudoers_hide)"
        out_menu_choice 72 submit-sudoer-request "$(app_menu_text sudoers_72_long)"
        out_menu_choice 75 remove-project-sudoers "$(app_menu_text sudoers_75_long)"
        out_menu_choice 0 "$(app_menu_text word_back)"
        out_msg_n "$(app_menu_text line_prompt)"
        if ! read -r _prompt_line; then
            unset _a
            return 0
        fi
        _pick="${_prompt_line}"
        case "${_pick}" in
            0|back|Back|""|exit|quit|Exit|QUIT|q|Q|返回|Atrás|Retour|Zurück|戻る|뒤로)
                unset _pick _a
                return 0
                ;;
            72|submit-sudoer-request)
                app_menu_draw_off
                app_menu_run_leaf submit-sudoer-request "${_a}"
                unset _pick _a
                return 2
                ;;
            75|remove-project-sudoers)
                app_menu_draw_off
                app_menu_run_leaf remove-project-sudoers "${_a}"
                unset _pick _a
                return 2
