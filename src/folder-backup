# =============================================================================
# fb_sanitize_folder_name() - Path-safe basename for archive naming (class B)
# =============================================================================
fb_sanitize_folder_name() {
    _raw="${1:-}"
    _base=$(basename -- "${_raw}" 2>/dev/null || echo "")
    case "${_base}" in
        ""|"."|".."|/)
            printf '%s' ""
            return 1
            ;;
    esac
    # Collapse unsafe chars to underscore (POSIX tr)
    _safe=$(printf '%s' "${_base}" | tr -c 'A-Za-z0-9._-' '_' 2>/dev/null || printf '%s' "${_base}")
    printf '%s' "${_safe}"
}

# =============================================================================
# fb_next_archive_name() - Next free SOURCE-YYYYMMDD-N.tar.gz under deposit dir
# =============================================================================
#
# GENERAL PURPOSE:
# Allocate next N for the day without overwriting existing archives.
# Class B: prints basename only on stdout.
#
# Last reviewed: 2026-08-03
# =============================================================================
fb_next_archive_name() {
    _src_name="${1:-}"
    _dest_dir="${2:-}"
    _day=$(date +%Y%m%d)
    _n=1
    while [ -e "${_dest_dir}/${_src_name}-${_day}-${_n}.tar.gz" ]; do
        _n=$((_n + 1))
        if [ "${_n}" -gt 9999 ]; then
            printf '%s' ""
            return 1
        fi
    done
    printf '%s' "${_src_name}-${_day}-${_n}.tar.gz"
}

# =============================================================================
# fb_count_path_entries / fb_count_path_files - Source tree counts (Class B)
# =============================================================================
#
# GENERAL PURPOSE:
# Count filesystem entries (find) and regular files under a source directory
# for post-tar and post-deposit verification. Prints a single integer on stdout.
#
# ALIGNMENT: requirement-domain-folder-backup.md (backup verification)
# =============================================================================
fb_count_path_entries() {
    _root="${1:-}"
    if [ -z "${_root}" ] || [ ! -d "${_root}" ]; then
        printf '%s' "0"
        return 1
    fi
    # Include the root directory itself (matches tar -C parent leaf member set)
    find "${_root}" 2>/dev/null | wc -l | tr -d ' \t'
}

fb_count_path_files() {
    _root="${1:-}"
    if [ -z "${_root}" ] || [ ! -d "${_root}" ]; then
        printf '%s' "0"
        return 1
    fi
    find "${_root}" -type f 2>/dev/null | wc -l | tr -d ' \t'
}

# =============================================================================
# fb_tar_list_stream() - List archive members (elevated when deposit is root-owned)
# =============================================================================
#
# GENERAL PURPOSE:
# Stream `tar -tzf` listing for a .tar.gz. Prefer direct read; if unreadable,
# use allowlisted `sudo -n /usr/bin/tar -tzf` (or /bin/tar) for Type 1 verify.
#
# Class B: member paths on stdout. Exit non-zero if listing fails.
# =============================================================================
fb_tar_list_stream() {
    _arc="${1:-}"
    if [ -z "${_arc}" ]; then
        return 1
    fi
    if [ -r "${_arc}" ] || [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        tar -tzf "${_arc}"
        return $?
    fi
    # Non-root + root-owned deposit: elevate narrow tar list only
    if ! command -v sudo >/dev/null 2>&1; then
        return 1
    fi
    if [ -x /usr/bin/tar ]; then
        if sudo -n /usr/bin/tar -tzf "${_arc}" 2>/dev/null; then
            return 0
        fi
    fi
    if [ -x /bin/tar ]; then
        if sudo -n /bin/tar -tzf "${_arc}" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

# =============================================================================
# fb_count_tar_members / fb_count_tar_files - Archive inventory (Class B)
# =============================================================================
#
# GENERAL PURPOSE:
# Count tar members and non-directory members (no trailing /) for verification.
# =============================================================================
fb_count_tar_members() {
    _arc="${1:-}"
    _list=$(fb_tar_list_stream "${_arc}" 2>/dev/null) || {
        printf '%s' ""
        return 1
    }
    if [ -z "${_list}" ]; then
        printf '%s' "0"
        return 0
    fi
    printf '%s\n' "${_list}" | wc -l | tr -d ' \t'
}

fb_count_tar_files() {
    _arc="${1:-}"
    _list=$(fb_tar_list_stream "${_arc}" 2>/dev/null) || {
        printf '%s' ""
        return 1
    }
    if [ -z "${_list}" ]; then
        printf '%s' "0"
        return 0
    fi
    # Members whose path does not end with / are non-directory entries (files, links)
    printf '%s\n' "${_list}" | awk '!/\/$/ { n++ } END { print n+0 }'
}

# =============================================================================
# fb_file_size_bytes() - Size of a path (Class B; metadata, no full read)
# =============================================================================
fb_file_size_bytes() {
    _path="${1:-}"
    if [ -z "${_path}" ]; then
        printf '%s' ""
        return 1
    fi
    if command -v stat >/dev/null 2>&1; then
        # GNU stat first; BSD fallback
        _sz=$(stat -c %s "${_path}" 2>/dev/null || stat -f %z "${_path}" 2>/dev/null || true)
        if [ -n "${_sz}" ]; then
            printf '%s' "${_sz}"
            return 0
        fi
    fi
    wc -c < "${_path}" 2>/dev/null | tr -d ' \t'
}

# =============================================================================
# fb_verify_archive_counts() - Fail-closed count + size verification
# =============================================================================
#
# GENERAL PURPOSE:
# Compare source tree inventory to staged/deposited archive inventory.
# Args: source_abs stage_or_dest_archive expected_members expected_files
# Also checks non-zero size. Uses elevated tar list when deposit is unreadable.
#
# ALIGNMENT:
# - requirement-domain-folder-backup.md (post-deposit verification)
# - requirement-three-layer-privilege-model.md (Type 1 verify Cmnds)
#
# Last reviewed: 2026-08-03
# =============================================================================
fb_verify_archive_counts() {
    _source_abs="${1:-}"
    _archive="${2:-}"
    _expect_members="${3:-}"
    _expect_files="${4:-}"
    _label="${5:-archive}"

    if [ -z "${_archive}" ] || [ ! -e "${_archive}" ]; then
        out_die "Verification failed: ${_label} missing: ${_archive}"
    fi

    _sz=$(fb_file_size_bytes "${_archive}")
    if [ -z "${_sz}" ] || [ "${_sz}" -le 0 ] 2>/dev/null; then
        out_die "Verification failed: ${_label} empty or unreadable size: ${_archive}"
    fi

    _got_members=$(fb_count_tar_members "${_archive}") || _got_members=""
    if [ -z "${_got_members}" ]; then
        out_die "Verification failed: cannot list ${_label} (need readable archive or allowlisted sudo tar -tzf). Run: ${APP_NAME:-folder-backup} print-sudoers"
    fi
    _got_files=$(fb_count_tar_files "${_archive}") || _got_files=""
    if [ -z "${_got_files}" ]; then
        out_die "Verification failed: cannot count files in ${_label}"
    fi

    if [ -n "${_expect_members}" ] && [ "${_got_members}" -ne "${_expect_members}" ]; then
        out_die "Verification failed: ${_label} member count ${_got_members} != expected ${_expect_members}"
    fi
    if [ -n "${_expect_files}" ] && [ "${_got_files}" -ne "${_expect_files}" ]; then
        out_die "Verification failed: ${_label} file count ${_got_files} != expected ${_expect_files}"
    fi

    # Optional source re-check when source still available
    if [ -n "${_source_abs}" ] && [ -d "${_source_abs}" ]; then
        _src_entries=$(fb_count_path_entries "${_source_abs}")
        _src_files=$(fb_count_path_files "${_source_abs}")
        if [ "${_got_members}" -ne "${_src_entries}" ]; then
            out_die "Verification failed: ${_label} members ${_got_members} != source entries ${_src_entries}"
        fi
        if [ "${_got_files}" -ne "${_src_files}" ]; then
            out_die "Verification failed: ${_label} files ${_got_files} != source files ${_src_files}"
        fi
    fi

    # Export last verify results for caller (shell globals)
    FB_VERIFY_MEMBERS="${_got_members}"
    FB_VERIFY_FILES="${_got_files}"
    FB_VERIFY_SIZE="${_sz}"
    return 0
}

# =============================================================================
# fb_deposit_archive() - Type 1 elevated copy into /var/backup/notation
# =============================================================================
fb_deposit_archive() {
    _stage_file="${1:-}"
    _dest_file="${2:-}"
    : "${BACKUP_ROOT:=/var/backup}"
    : "${BACKUP_NOTATION:=folder-backup}"

    _dest_dir=$(dirname -- "${_dest_file}")

    if [ ! -f "${_stage_file}" ]; then
        out_die "Staged archive missing: ${_stage_file}"
    fi

    # Prefer install for mode control when available
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        if [ ! -d "${_dest_dir}" ]; then
            mkdir -p "${_dest_dir}" || out_die "Cannot create ${_dest_dir}"
        fi
        if command -v install >/dev/null 2>&1; then
            install -m 0640 "${_stage_file}" "${_dest_file}" || out_die "Root deposit failed"
        else
            cp "${_stage_file}" "${_dest_file}" || out_die "Root deposit failed"
            chmod 0640 "${_dest_file}" 2>/dev/null || true
        fi
        return 0
    fi

    # Non-root Type 0: writable custom/test deposit dir (BACKUP_ROOT override)
    if [ ! -d "${_dest_dir}" ]; then
        mkdir -p "${_dest_dir}" 2>/dev/null || true
    fi
    if [ -d "${_dest_dir}" ] && [ -w "${_dest_dir}" ]; then
        if command -v install >/dev/null 2>&1; then
            if install -m 0640 "${_stage_file}" "${_dest_file}" 2>/dev/null; then
                return 0
            fi
        fi
        if cp "${_stage_file}" "${_dest_file}" 2>/dev/null; then
            chmod 0640 "${_dest_file}" 2>/dev/null || true
            return 0
        fi
    fi

    # Non-root: require allowlisted sudo for root-owned deposit
    if ! command -v sudo >/dev/null 2>&1; then
        out_die "sudo not found. Deposit requires elevated copy into ${BACKUP_ROOT}/${BACKUP_NOTATION}/. Run: ${APP_NAME} print-sudoers"
    fi

    # Create destination dir if fragment allows; best-effort then copy
    if ! sudo -n mkdir -p "${_dest_dir}" 2>/dev/null; then
        if [ ! -d "${_dest_dir}" ]; then
            out_die "Cannot create ${_dest_dir} (need admin sudoers). Run: ${APP_NAME} print-sudoers"
        fi
    fi

    if command -v install >/dev/null 2>&1; then
        if sudo -n install -m 0640 "${_stage_file}" "${_dest_file}" 2>/dev/null; then
            return 0
        fi
    fi
    if sudo -n cp "${_stage_file}" "${_dest_file}" 2>/dev/null; then
        sudo -n chmod 0640 "${_dest_file}" 2>/dev/null || true
        return 0
    fi

    out_die "Deposit failed (sudo not authorized for copy into ${_dest_dir}). Run: ${APP_NAME} print-sudoers and ask admin to install fragment under /etc/sudoers.d/"
}

# =============================================================================
# fb_positive_int_or_default() - Class B: validate positive integer env caps
# =============================================================================
fb_positive_int_or_default() {
    _raw="${1:-}"
    _def="${2:-1}"
    case "${_raw}" in
        ''|*[!0-9]*)
            printf '%s' "${_def}"
            return 0
            ;;
    esac
    if [ "${_raw}" -le 0 ] 2>/dev/null; then
        printf '%s' "${_def}"
        return 0
    fi
    printf '%s' "${_raw}"
}

# =============================================================================
# fb_match_product_archive_basename() - Class B: exit 0 if NAME-YYYYMMDD-N.tar.gz
# Args: file_basename source_folder_name
# =============================================================================
fb_match_product_archive_basename() {
    _bn="${1:-}"
    _src="${2:-}"
    [ -n "${_bn}" ] && [ -n "${_src}" ] || return 1
    case "${_bn}" in
        "${_src}"-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*.tar.gz) ;;
        *) return 1 ;;
    esac
    _rest="${_bn#${_src}-}"
    _daypart=$(printf '%s' "${_rest}" | cut -c1-8)
    _npart="${_rest#????????-}"
    _npart="${_npart%.tar.gz}"
    case "${_daypart}" in
        [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) ;;
        *) return 1 ;;
    esac
    case "${_npart}" in
        ''|*[!0-9]*) return 1 ;;
    esac
    return 0
}

# =============================================================================
# fb_remove_deposit_archive() - Delete one durable archive (Type 0 or allowlisted)
# =============================================================================
#
# ALIGNMENT: retention-total / retention-daily · three-layer narrow rm
# =============================================================================
fb_remove_deposit_archive() {
    _path="${1:-}"
    : "${BACKUP_ROOT:=/var/backup}"
    : "${BACKUP_NOTATION:=folder-backup}"
    _dep="${BACKUP_ROOT}/${BACKUP_NOTATION}"

    [ -n "${_path}" ] || return 1
    case "${_path}" in
        "${_dep}"/*) ;;
        *)
            out_warn "Retention refuse delete outside deposit: ${_path}"
            return 1
            ;;
    esac
    case "${_path}" in
        *.tar.gz) ;;
        *)
            out_warn "Retention refuse delete non-archive: ${_path}"
            return 1
            ;;
    esac
    if [ ! -e "${_path}" ]; then
        return 0
    fi

    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        rm -f "${_path}" 2>/dev/null && return 0
        return 1
    fi
    # Type 0 when writable (user-owned / test deposit)
    if [ -w "${_path}" ] || { [ -d "${_dep}" ] && [ -w "${_dep}" ]; }; then
        if rm -f "${_path}" 2>/dev/null; then
            return 0
        fi
    fi
    if command -v sudo >/dev/null 2>&1; then
        if sudo -n /bin/rm -f "${_path}" 2>/dev/null \
            || sudo -n /usr/bin/rm -f "${_path}" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

# =============================================================================
# fb_apply_retention() - Daily then total prune after successful deposit
# =============================================================================
#
# GENERAL PURPOSE:
# Enforce MAX_DAILY_BACKUPS (default 5) for basename+day, then MAX_TOTAL_BACKUPS
# (default 30) for basename across all days. Oldest first (day asc, N asc).
#
# ALIGNMENT:
# - requirement-folder-archive-backup-retention-daily.md
# - requirement-folder-archive-backup-retention-total.md
#
# Sets globals: FB_RETENTION_DAILY_REMOVED FB_RETENTION_TOTAL_REMOVED
#               FB_RETENTION_DAILY_REMAINING FB_RETENTION_TOTAL_REMAINING
# =============================================================================
fb_apply_retention() {
    _src_name="${1:-}"
    _dest_dir="${2:-}"
    _day="${3:-}"
    : "${APP_NAME:=folder-backup}"
    : "${MAX_DAILY_BACKUPS:=5}"
    : "${MAX_TOTAL_BACKUPS:=30}"

    FB_RETENTION_DAILY_REMOVED=0
    FB_RETENTION_TOTAL_REMOVED=0
    FB_RETENTION_DAILY_REMAINING=0
    FB_RETENTION_TOTAL_REMAINING=0

    [ -n "${_src_name}" ] && [ -n "${_dest_dir}" ] && [ -d "${_dest_dir}" ] || return 0
    if [ -z "${_day}" ]; then
        _day=$(date +%Y%m%d)
    fi

    _max_daily=$(fb_positive_int_or_default "${MAX_DAILY_BACKUPS}" 5)
    _max_total=$(fb_positive_int_or_default "${MAX_TOTAL_BACKUPS}" 30)
    MAX_DAILY_BACKUPS="${_max_daily}"
    MAX_TOTAL_BACKUPS="${_max_total}"

    # --- Daily prune: rebuild sorted list each pass (lowest N first) ---
    _guard=0
    while [ "${_guard}" -lt 10000 ]; do
        _guard=$((_guard + 1))
        _daily_sorted=$(
            for _f in "${_dest_dir}"/*; do
                [ -f "${_f}" ] || continue
                _bn=$(basename -- "${_f}")
                fb_match_product_archive_basename "${_bn}" "${_src_name}" || continue
                case "${_bn}" in
                    "${_src_name}-${_day}-"*.tar.gz) ;;
                    *) continue ;;
                esac
                _n="${_bn#${_src_name}-${_day}-}"
                _n="${_n%.tar.gz}"
                case "${_n}" in
                    ''|*[!0-9]*) continue ;;
                esac
                printf '%s\t%s\n' "${_n}" "${_f}"
            done | sort -n -k1,1
        )
        _daily_count=0
        if [ -n "${_daily_sorted}" ]; then
            _daily_count=$(printf '%s\n' "${_daily_sorted}" | grep -c . 2>/dev/null || echo 0)
        fi
        _daily_count=$(printf '%s' "${_daily_count}" | tr -d ' \t\r\n')
        [ -n "${_daily_count}" ] || _daily_count=0
        FB_RETENTION_DAILY_REMAINING="${_daily_count}"
        if [ "${_daily_count}" -le "${_max_daily}" ]; then
            break
        fi
        _oldpath=$(printf '%s\n' "${_daily_sorted}" | head -n1 | cut -f2-)
        if [ -z "${_oldpath}" ] || [ ! -e "${_oldpath}" ]; then
            break
        fi
        out_info "Retention daily: removing oldest same-day archive ${_oldpath} (cap=${_max_daily})"
        if ! fb_remove_deposit_archive "${_oldpath}"; then
            out_die "Retention daily prune failed (cannot remove ${_oldpath}). Run: ${APP_NAME} print-sudoers (need allowlisted rm under deposit) and admin-install fragment"
        fi
        FB_RETENTION_DAILY_REMOVED=$((FB_RETENTION_DAILY_REMOVED + 1))
    done

    # --- Total prune: oldest YYYYMMDD then N ---
    _guard=0
    while [ "${_guard}" -lt 10000 ]; do
        _guard=$((_guard + 1))
        _total_sorted=$(
            for _f in "${_dest_dir}"/*; do
                [ -f "${_f}" ] || continue
                _bn=$(basename -- "${_f}")
                fb_match_product_archive_basename "${_bn}" "${_src_name}" || continue
                _rest="${_bn#${_src_name}-}"
                _dpart=$(printf '%s' "${_rest}" | cut -c1-8)
                _npart="${_rest#????????-}"
                _npart="${_npart%.tar.gz}"
                case "${_npart}" in
                    ''|*[!0-9]*) continue ;;
                esac
                printf '%s\t%s\t%s\n' "${_dpart}" "${_npart}" "${_f}"
            done | sort -k1,1 -k2,2n
        )
        _total_count=0
        if [ -n "${_total_sorted}" ]; then
            _total_count=$(printf '%s\n' "${_total_sorted}" | grep -c . 2>/dev/null || echo 0)
        fi
        _total_count=$(printf '%s' "${_total_count}" | tr -d ' \t\r\n')
        [ -n "${_total_count}" ] || _total_count=0
        FB_RETENTION_TOTAL_REMAINING="${_total_count}"
        if [ "${_total_count}" -le "${_max_total}" ]; then
            break
        fi
        _oldpath=$(printf '%s\n' "${_total_sorted}" | head -n1 | cut -f3-)
        if [ -z "${_oldpath}" ] || [ ! -e "${_oldpath}" ]; then
            break
        fi
        out_info "Retention total: removing oldest archive ${_oldpath} (cap=${_max_total})"
        if ! fb_remove_deposit_archive "${_oldpath}"; then
            out_die "Retention total prune failed (cannot remove ${_oldpath}). Run: ${APP_NAME} print-sudoers (need allowlisted rm under deposit) and admin-install fragment"
        fi
        FB_RETENTION_TOTAL_REMOVED=$((FB_RETENTION_TOTAL_REMOVED + 1))
    done

    if [ "${FB_RETENTION_DAILY_REMOVED}" -gt 0 ] || [ "${FB_RETENTION_TOTAL_REMOVED}" -gt 0 ]; then
        out_info "Retention: daily_removed=${FB_RETENTION_DAILY_REMOVED} daily_remaining=${FB_RETENTION_DAILY_REMAINING}/${_max_daily} total_removed=${FB_RETENTION_TOTAL_REMOVED} total_remaining=${FB_RETENTION_TOTAL_REMAINING}/${_max_total}"
    fi
    return 0
}

# =============================================================================
# fb_backup() - Domain: tar.gz source folder, elevated deposit, verify counts
# =============================================================================
#
# GENERAL PURPOSE:
# Validate source directory, create gzip tar in isolated staging, allocate
# next archive name, elevate copy into /var/backup/${BACKUP_NOTATION}/, then
# fail-closed verify member/file counts (and size) on stage and deposit.
# Deposit archives are often root:root 0640 — listing uses Type 1 sudo tar -tzf.
#
# ALIGNMENT:
# - requirement-folder-archive-backup.md  (ops SSOT)
# - requirement-folder-archive-backup-retention-daily.md
# - requirement-folder-archive-backup-retention-total.md
# - requirement-three-layer-privilege-model.md
# - requirement-shell-cli-storage.md
# - requirement-domain-folder-backup.md    (verb surface only)
#
# Last reviewed: 2026-08-12
# =============================================================================
fb_backup() {
    : "${APP_NAME:=folder-backup}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${BACKUP_ROOT:=/var/backup}"
    : "${BACKUP_NOTATION:=folder-backup}"
    : "${HOME:=/tmp}"
    : "${USERNAME:=unknown}"
    : "${VERSION:=1.8.0}"
    : "${MAX_DAILY_BACKUPS:=5}"
    : "${MAX_TOTAL_BACKUPS:=30}"

    _source="${1:-}"
    if [ -z "${_source}" ]; then
        out_die "Usage: ${APP_NAME} backup <source-folder>"
    fi
    if [ ! -d "${_source}" ]; then
        out_die "Source is not a directory: ${_source}"
    fi
    if [ ! -r "${_source}" ]; then
        out_die "Source directory is not readable: ${_source}"
    fi

    # Resolve absolute source
    _source_abs=$(CDPATH= cd -- "${_source}" 2>/dev/null && pwd) || out_die "Cannot resolve source path: ${_source}"
    _src_name=$(fb_sanitize_folder_name "${_source_abs}")
    if [ -z "${_src_name}" ]; then
        out_die "Invalid source folder name"
    fi

    if [ -z "${EFFECTIVE_STORAGE_DIR:-}" ]; then
        EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    fi
    _dest_dir="${BACKUP_ROOT}/${BACKUP_NOTATION}"
    # For next-N scan: if dest not readable, still allocate N=1 for planned name
    _archive_name=$(fb_next_archive_name "${_src_name}" "${_dest_dir}")
    if [ -z "${_archive_name}" ]; then
        out_die "Could not allocate archive name under ${_dest_dir}"
    fi

    # Stage at one path segment under the resolved cache root
    # (e.g. /dev/shm/cache/cache-folder-backup/NAME.tar.gz).
    _stage_file="${EFFECTIVE_STORAGE_DIR}/${_archive_name}"
    _parent=$(dirname -- "${_source_abs}")
    _leaf=$(basename -- "${_source_abs}")

    # Cleanup staging on exit
    _fb_cleanup() {
        rm -f "${_stage_file}" 2>/dev/null || true
    }
    trap '_fb_cleanup' EXIT INT TERM

    # Source inventory (before tar)
    _src_entries=$(fb_count_path_entries "${_source_abs}")
    _src_files=$(fb_count_path_files "${_source_abs}")
    out_info "Source inventory: entries=${_src_entries} files=${_src_files}"

    out_info "Creating archive ${_archive_name} from ${_source_abs}"
    if ! command -v tar >/dev/null 2>&1; then
        out_die "tar is required for backup"
    fi

    # Create gzip tar with top-level folder = leaf basename
    if ! tar -C "${_parent}" -czf "${_stage_file}" "${_leaf}"; then
        out_die "tar failed for ${_source_abs}"
    fi
    chmod 0600 "${_stage_file}" 2>/dev/null || true

    # Verify staged archive against source (readable as invoking user)
    out_info "Verifying staged archive counts..."
    fb_verify_archive_counts "${_source_abs}" "${_stage_file}" "${_src_entries}" "${_src_files}" "staged archive"
    _stage_members="${FB_VERIFY_MEMBERS}"
    _stage_files="${FB_VERIFY_FILES}"
    _stage_size="${FB_VERIFY_SIZE}"
    out_info "Staged OK: members=${_stage_members} files=${_stage_files} size=${_stage_size}"

    _dest_file="${_dest_dir}/${_archive_name}"
    out_info "Depositing to ${_dest_file}"
    fb_deposit_archive "${_stage_file}" "${_dest_file}"

    # -------------------------------------------------------------------------
    # Post-deposit verification (keep stage until done)
    # 1) Size must match stage (metadata; no archive read required)
    # 2) Prefer re-list deposited archive (direct or Type 1 sudo tar -tzf)
    # 3) If re-list unavailable, stage already matched source — still report counts
    # -------------------------------------------------------------------------
    out_info "Verifying deposited archive..."
    if [ ! -e "${_dest_file}" ]; then
        out_die "Verification failed: deposited archive missing: ${_dest_file}"
    fi
    _dest_size=$(fb_file_size_bytes "${_dest_file}")
    if [ -z "${_dest_size}" ] || [ "${_dest_size}" -le 0 ] 2>/dev/null; then
        out_die "Verification failed: deposited archive empty or unreadable size: ${_dest_file}"
    fi
    if [ -n "${_stage_size}" ] && [ "${_stage_size}" -ne "${_dest_size}" ]; then
        out_die "Verification failed: deposited size ${_dest_size} != staged size ${_stage_size}"
    fi

    _verify_mode="stage_counts+dest_size"
    _dest_members="${_stage_members}"
    _dest_files="${_stage_files}"
    # Prefer re-list deposited archive (direct read or Type 1 sudo tar -tzf)
    _rel_members=$(fb_count_tar_members "${_dest_file}" 2>/dev/null) || _rel_members=""
    _rel_files=$(fb_count_tar_files "${_dest_file}" 2>/dev/null) || _rel_files=""
    if [ -n "${_rel_members}" ] && [ -n "${_rel_files}" ]; then
        if [ "${_rel_members}" -ne "${_stage_members}" ]; then
            out_die "Verification failed: deposited members ${_rel_members} != staged ${_stage_members}"
        fi
        if [ "${_rel_files}" -ne "${_stage_files}" ]; then
            out_die "Verification failed: deposited files ${_rel_files} != staged ${_stage_files}"
        fi
        if [ "${_rel_members}" -ne "${_src_entries}" ] || [ "${_rel_files}" -ne "${_src_files}" ]; then
            out_die "Verification failed: deposited inventory does not match source (members=${_rel_members} files=${_rel_files} source_entries=${_src_entries} source_files=${_src_files})"
        fi
        _dest_members="${_rel_members}"
        _dest_files="${_rel_files}"
        _verify_mode="dest_tar_list+size"
        out_info "Deposited re-list OK: members=${_dest_members} files=${_dest_files} size=${_dest_size}"
    else
        # Re-list may need allowlisted: sudo -n tar -tzf under deposit dir
        # Stage was already verified against source; size match proves deposit bytes.
        out_info "Deposited size OK (${_dest_size}); re-list unavailable (add tar -tzf to sudoers via print-sudoers for full re-verify)"
        out_info "Using staged inventory: members=${_dest_members} files=${_dest_files}"
    fi

    # Success: remove stage (trap will also run)
    rm -f "${_stage_file}" 2>/dev/null || true
    trap - EXIT INT TERM

    # Retention: daily (max 5) then total (max 30) per basename
    _ret_day=$(date +%Y%m%d)
    case "${_archive_name}" in
        *-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*)
            _ret_day=$(printf '%s' "${_archive_name}" | sed -n 's/.*-\([0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]\)-[0-9][0-9]*\.tar\.gz$/\1/p')
            [ -n "${_ret_day}" ] || _ret_day=$(date +%Y%m%d)
            ;;
    esac
    fb_apply_retention "${_src_name}" "${_dest_dir}" "${_ret_day}"

    out_success "Backup complete: ${_dest_file}"
    out_success "Verified: source_files=${_src_files} archive_files=${_dest_files} members=${_dest_members} size=${_dest_size} mode=${_verify_mode}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "backup" "ok" \
            "app" "${APP_NAME}" \
            "source" "${_source_abs}" \
            "archive_name" "${_archive_name}" \
            "destination" "${_dest_file}" \
            "backup_notation" "${BACKUP_NOTATION}" \
            "source_entries" "${_src_entries}" \
            "source_files" "${_src_files}" \
            "archive_members" "${_dest_members}" \
            "archive_files" "${_dest_files}" \
            "archive_size" "${_dest_size}" \
            "verified" "true" \
            "verify_mode" "${_verify_mode}" \
            "retention_daily_cap" "${MAX_DAILY_BACKUPS}" \
            "retention_daily_removed" "${FB_RETENTION_DAILY_REMOVED:-0}" \
            "retention_daily_remaining" "${FB_RETENTION_DAILY_REMAINING:-0}" \
            "retention_total_cap" "${MAX_TOTAL_BACKUPS}" \
            "retention_total_removed" "${FB_RETENTION_TOTAL_REMOVED:-0}" \
            "retention_total_remaining" "${FB_RETENTION_TOTAL_REMAINING:-0}" \
            "version" "${VERSION}"
    fi
    return 0
}

# =============================================================================
# util_resolve_projects_root() - Hard-disk projects tree (Class B stdout)
# =============================================================================
#
# GENERAL PURPOSE:
# Resolve {{PROJECTS_ROOT}} for hard-disk restore SSOT without assuming one host
# when env is set; fall back to common layout detection.
# =============================================================================
util_resolve_projects_root() {
    if [ -n "${PROJECTS_ROOT:-}" ] && [ -d "${PROJECTS_ROOT}" ]; then
        printf '%s' "${PROJECTS_ROOT}"
        return 0
    fi
    # Detect .../prjs from this script location when ship unit lives under a projects tree
    _here=$(CDPATH= cd -- "$(dirname -- "$0" 2>/dev/null || echo ".")" 2>/dev/null && pwd) || _here=""
    case "${_here}" in
        */prjs/*|*/prjs)
            _cand=$(printf '%s' "${_here}" | sed -n 's|\(.*)/prjs\(/.*\)\?|\1/prjs|p')
            if [ -n "${_cand}" ] && [ -d "${_cand}" ]; then
                printf '%s' "${_cand}"
                return 0
            fi
            ;;
    esac
    for _cand in \
        "/var/www/grok.dr-sense.com/prjs" \
        "${HOME}/prjs" \
        "/var/www/html/prjs"
    do
        if [ -d "${_cand}" ]; then
            printf '%s' "${_cand}"
            return 0
        fi
    done
    printf '%s' ""
    return 1
}

# =============================================================================
# fb_parse_archive_project_name() - NAME from NAME-YYYYMMDD-N.tar.gz (Class B)
# =============================================================================
fb_parse_archive_project_name() {
    _arc="${1:-}"
    _bn=$(basename -- "${_arc}")
    _bn=$(printf '%s' "${_bn}" | sed 's/\.tar\.gz$//')
    # Strip trailing -YYYYMMDD-N
    _name=$(printf '%s' "${_bn}" | sed -E 's/-[0-9]{8}-[0-9]+$//')
    if [ -z "${_name}" ] || [ "${_name}" = "${_bn}" ]; then
        # Not matching pattern: use full basename without .tar.gz
        printf '%s' "${_bn}"
        return 0
    fi
    printf '%s' "${_name}"
}

# =============================================================================
# fb_refuse_restore_dest() - Restore dest whitelist gate (RQ §2.6b.2a)
# =============================================================================
#
# GENERAL PURPOSE:
# Fail closed on hard-deny paths; allow only whitelist rows:
#   W-ETC-USER  /etc/{{username}} (+ children); never /etc/passwd
#   W-HOME      invoking passwd home (+ children) when not already covered
#   W-DISK/W-RAM/tmp/other non-system paths remain allow-by-path (not under
#               hard system under-prefix refuse)
# Hard deny wins over every W-* row.
#
# ALIGNMENT:
# - requirement-folder-archive-backup.md §2.6b.2a (W-ETC-USER, /etc/passwd)
# - INC-20260812-001
# =============================================================================
fb_refuse_restore_dest() {
    _d="${1:-}"
    [ -n "${_d}" ] || out_die "Restore destination empty"

    # Hard deny: exact OS roots
    case "${_d}" in
        /|/bin|/boot|/dev|/etc|/lib|/lib64|/proc|/root|/run|/sbin|/sys|/usr|/var)
            out_die "Refusing restore to dangerous system path: ${_d}"
            ;;
    esac

    # Hard deny: system account database (never a restore dest)
    if [ "${_d}" = "/etc/passwd" ]; then
        out_die "Refusing restore to protected system path: /etc/passwd"
    fi

    : "${BACKUP_ROOT:=/var/backup}"
    : "${BACKUP_NOTATION:=folder-backup}"
    _dep="${BACKUP_ROOT}/${BACKUP_NOTATION}"
    if [ "${_d}" = "${BACKUP_ROOT}" ] || [ "${_d}" = "${_dep}" ]; then
        out_die "Refusing restore into deposit tree: ${_d}"
    fi
    case "${_d}" in
        "${_dep}"/*)
            out_die "Refusing restore into deposit tree: ${_d}"
            ;;
    esac

    _user=$(id -un 2>/dev/null || printf '%s' "")
    # W-ETC-USER: /etc/{{username}} or strict child (invoking user only).
    # Hard deny /etc/passwd already handled; username "passwd" must not open a loophole.
    if [ -n "${_user}" ] && [ "${_user}" != "passwd" ]; then
        case "${_d}" in
            "/etc/${_user}"|"/etc/${_user}"/*)
                return 0
                ;;
        esac
    fi

    # W-HOME: invoking passwd home or strict child
    _home=""
    if [ -n "${_user}" ] && command -v getent >/dev/null 2>&1; then
        _home=$(getent passwd "${_user}" 2>/dev/null | cut -d: -f6)
    fi
    if [ -z "${_home}" ] && [ -n "${HOME-}" ]; then
        _home="${HOME}"
    fi
    if [ -n "${_home}" ] && [ "${_home}" != "/" ] && [ "${_home}" != "/etc/passwd" ]; then
        case "${_d}" in
            "${_home}"|"${_home}"/*)
                return 0
                ;;
        esac
    fi

    # Under other FHS system prefixes: refuse (not on whitelist)
    case "${_d}" in
        /bin/*|/boot/*|/dev/*|/etc/*|/lib/*|/lib64/*|/proc/*|/root/*|/run/*|/sbin/*|/sys/*|/usr/*)
            out_die "Refusing restore under system path (not on restore dest whitelist): ${_d}"
            ;;
    esac

    return 0
}

# =============================================================================
# fb_resolve_archive_path() - Find durable archive under deposit (Class B stdout)
# =============================================================================
#
# GENERAL PURPOSE:
# Resolve user archive operand to an absolute .tar.gz path under deposit dir
# (or an explicit path). Supports exact name, absolute path, or project prefix
# (latest NAME-YYYYMMDD-N.tar.gz).
# =============================================================================
fb_resolve_archive_path() {
    _spec="${1:-}"
    : "${BACKUP_ROOT:=/var/backup}"
    : "${BACKUP_NOTATION:=folder-backup}"
    _dep="${BACKUP_ROOT}/${BACKUP_NOTATION}"

    if [ -z "${_spec}" ]; then
        printf '%s' ""
        return 1
    fi
    # Existing file (absolute or relative)
    if [ -f "${_spec}" ]; then
        _dir=$(CDPATH= cd -- "$(dirname -- "${_spec}")" 2>/dev/null && pwd) || _dir=""
        if [ -n "${_dir}" ]; then
            printf '%s/%s' "${_dir}" "$(basename -- "${_spec}")"
            return 0
        fi
        printf '%s' "${_spec}"
        return 0
    fi
    # Exact basename under deposit
    if [ -f "${_dep}/${_spec}" ]; then
        printf '%s' "${_dep}/${_spec}"
        return 0
    fi
    # Add .tar.gz if omitted
    case "${_spec}" in
        *.tar.gz) ;;
        *)
            if [ -f "${_dep}/${_spec}.tar.gz" ]; then
                printf '%s' "${_dep}/${_spec}.tar.gz"
                return 0
            fi
            ;;
    esac
    # Prefix match: latest by sort (YYYYMMDD-N sorts lexicographically for fixed width day)
    _latest=$(ls -1 "${_dep}/${_spec}"-*.tar.gz 2>/dev/null | sort | tail -n1)
    if [ -n "${_latest}" ] && [ -f "${_latest}" ]; then
        printf '%s' "${_latest}"
        return 0
    fi
    printf '%s' ""
    return 1
}

# =============================================================================
# fb_fetch_archive_readable() - Stage unreadable deposit archive for Type 0 tar
# =============================================================================
#
# GENERAL PURPOSE:
# If archive is not readable by invoking user (root:root 0640), copy via
# allowlisted sudo -n cp deposit/* → user stage, then return staged path.
# =============================================================================
fb_fetch_archive_readable() {
    # Class B: path only on stdout (no out_* chatter — would pollute $(…)).
    _arc="${1:-}"
    if [ -z "${_arc}" ] || [ ! -e "${_arc}" ]; then
        return 1
    fi
    if [ -r "${_arc}" ]; then
        printf '%s' "${_arc}"
        return 0
    fi
    if [ -z "${EFFECTIVE_STORAGE_DIR:-}" ]; then
        EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    fi
    _bn=$(basename -- "${_arc}")
    _stage="${EFFECTIVE_STORAGE_DIR}/${_bn}"
    if ! command -v sudo >/dev/null 2>&1; then
        return 1
    fi
    # Prefer absolute allowlisted paths matching print-sudoers reverse-cp lines
    if sudo -n /usr/bin/cp "${_arc}" "${EFFECTIVE_STORAGE_DIR}/" 2>/dev/null \
        || sudo -n /bin/cp "${_arc}" "${EFFECTIVE_STORAGE_DIR}/" 2>/dev/null; then
        if [ -r "${_stage}" ]; then
            printf '%s' "${_stage}"
            return 0
        fi
        if [ -r "${EFFECTIVE_STORAGE_DIR}/${_bn}" ]; then
            printf '%s' "${EFFECTIVE_STORAGE_DIR}/${_bn}"
            return 0
        fi
    fi
    return 1
}

# =============================================================================
# fb_list_archives() - Human/JSON list of deposit archives
# =============================================================================
fb_list_archives() {
    : "${BACKUP_ROOT:=/var/backup}"
    : "${BACKUP_NOTATION:=folder-backup}"
    : "${JSON:=0}"
    _dep="${BACKUP_ROOT}/${BACKUP_NOTATION}"
    if [ ! -d "${_dep}" ]; then
        out_warn "Deposit directory missing: ${_dep}"
        return 0
    fi
    if [ "${JSON}" -eq 1 ]; then
        _names=$(ls -1 "${_dep}"/*.tar.gz 2>/dev/null | xargs -n1 basename 2>/dev/null | tr '\n' ' ')
        out_json "list" "ok" "deposit_dir" "${_dep}" "archives" "${_names}"
        return 0
    fi
    out_info "Archives under ${_dep}:"
    ls -1 "${_dep}"/*.tar.gz 2>/dev/null | while read -r _f; do
        out_plain "  $(basename -- "${_f}")"
    done || out_plain "  (none)"
}

# =============================================================================
# fb_restore() - Extract durable archive to host project path
# =============================================================================
#
# GENERAL PURPOSE:
# Restore NAME-YYYYMMDD-N.tar.gz from deposit (or path) into a destination.
# Default destination SSOT is the **hard-disk** host version
# (${PROJECTS_ROOT}/${project}) — the reverse of ram-drive-first — unless the
# user specifies an explicit dest or RESTORE_HOST=ram-drive / --ram.
#
# ALIGNMENT:
# - requirement-folder-archive-backup.md (restore)
# - requirement-three-layer-privilege-model.md
# - policy-ram-drive-first (restore default = hard-disk peer)
#
# Last reviewed: 2026-08-03
# =============================================================================
fb_restore() {
    : "${APP_NAME:=folder-backup}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${FORCE:=0}"
    : "${BACKUP_ROOT:=/var/backup}"
    : "${BACKUP_NOTATION:=folder-backup}"
    : "${RESTORE_HOST_DEFAULT:=hard-disk}"
    : "${RAM_ROOT:=/dev/shm}"
    : "${VERSION:=1.2.0}"

    _spec="${1:-}"
    _dest_in="${2:-}"
    _host="${RESTORE_HOST:-${RESTORE_HOST_DEFAULT}}"

    if [ -z "${_spec}" ]; then
        fb_list_archives
        out_die "Usage: ${APP_NAME} restore <archive|project-prefix> [dest-dir]  (flags: --force --disk|--ram)"
    fi

    _arc=$(fb_resolve_archive_path "${_spec}") || _arc=""
    if [ -z "${_arc}" ] || [ ! -e "${_arc}" ]; then
        out_die "Archive not found for '${_spec}' under ${BACKUP_ROOT}/${BACKUP_NOTATION}/ (or path). Try: ${APP_NAME} restore"
    fi
    out_info "Archive: ${_arc}"

    _proj=$(fb_parse_archive_project_name "${_arc}")
    if [ -z "${_proj}" ]; then
        out_die "Could not parse project name from archive: ${_arc}"
    fi

    if [ -n "${_dest_in}" ]; then
        _dest=$(CDPATH= cd -- "$(dirname -- "${_dest_in}")" 2>/dev/null && printf '%s/%s' "$(pwd)" "$(basename -- "${_dest_in}")") \
            || _dest="${_dest_in}"
        # If relative path given without existing parent, absolutize later via mkdir parent
        case "${_dest_in}" in
            /*) _dest="${_dest_in}" ;;
            *)
                _dest="$(pwd)/${_dest_in}"
                ;;
        esac
        _host="explicit"
    else
        case "${_host}" in
            ram|ram-drive|shm)
                _host="ram-drive"
                _dest="${RAM_ROOT}/${_proj}"
                ;;
            disk|hard-disk|harddisk|hdd|*)
                _host="hard-disk"
                _proot=$(util_resolve_projects_root) || _proot=""
                if [ -z "${_proot}" ]; then
                    out_die "Cannot resolve PROJECTS_ROOT for hard-disk restore. Set PROJECTS_ROOT or pass explicit dest. (Default restore SSOT is hard-disk — reverse of ram-drive-first.)"
                fi
                _dest="${_proot}/${_proj}"
                ;;
        esac
    fi

    fb_refuse_restore_dest "${_dest}"
    out_info "Restore host SSOT: ${_host} → ${_dest}"

    _parent=$(dirname -- "${_dest}")
    _leaf=$(basename -- "${_dest}")
    if [ "${_leaf}" != "${_proj}" ]; then
        out_warn "Destination basename '${_leaf}' differs from archive project '${_proj}'; extracting archive top-level name into parent"
    fi

    if [ -e "${_dest}" ]; then
        _nonempty=$(find "${_dest}" -mindepth 1 2>/dev/null | head -n1 || true)
        if [ -n "${_nonempty}" ] && [ "${FORCE}" -ne 1 ]; then
            out_die "Destination not empty: ${_dest} (re-run with --force to overwrite/merge extract)"
        fi
    fi

    if [ ! -d "${_parent}" ]; then
        mkdir -p "${_parent}" || out_die "Cannot create parent directory: ${_parent}"
    fi

    # Stage readable archive (Class B fetch — messages only here)
    if [ -r "${_arc}" ]; then
        _work="${_arc}"
    else
        out_info "Archive not user-readable; elevating copy deposit → stage for restore"
        _work=$(fb_fetch_archive_readable "${_arc}") || _work=""
        if [ -z "${_work}" ] || [ ! -r "${_work}" ]; then
            out_die "Cannot stage archive for restore (need allowlisted sudo cp deposit→stage). Run: ${APP_NAME} print-sudoers and admin-install fragment"
        fi
    fi
    out_info "Readable archive for extract: ${_work}"

    # Expected inventory from archive listing
    _exp_members=$(fb_count_tar_members "${_work}") || _exp_members=""
    _exp_files=$(fb_count_tar_files "${_work}") || _exp_files=""
    if [ -n "${_exp_members}" ]; then
        out_info "Archive inventory: members=${_exp_members} files=${_exp_files:-?}"
    fi

    out_info "Extracting into ${_parent} (top-level folder from archive)"
    if ! tar -C "${_parent}" -xzf "${_work}"; then
        out_die "tar extract failed for ${_work}"
    fi

    # After extract, tree is ${_parent}/${_proj} if naming matches
    _restored="${_parent}/${_proj}"
    if [ ! -d "${_restored}" ]; then
        # fall back to dest if strip layout differs
        if [ -d "${_dest}" ]; then
            _restored="${_dest}"
        else
            out_die "Restore extract did not create expected directory: ${_parent}/${_proj}"
        fi
    fi

    # Verify counts against live tree
    _got_entries=$(fb_count_path_entries "${_restored}")
    _got_files=$(fb_count_path_files "${_restored}")
    if [ -n "${_exp_members}" ] && [ "${_got_entries}" -ne "${_exp_members}" ]; then
        out_die "Restore verification failed: tree entries ${_got_entries} != archive members ${_exp_members}"
    fi
    if [ -n "${_exp_files}" ] && [ "${_got_files}" -ne "${_exp_files}" ]; then
        out_die "Restore verification failed: tree files ${_got_files} != archive files ${_exp_files}"
    fi

    # Cleanup staged copy if it was a stage path under storage
    if [ "${_work}" != "${_arc}" ]; then
        rm -f "${_work}" 2>/dev/null || true
    fi

    out_success "Restore complete: ${_restored}"
    out_success "Verified: files=${_got_files} entries=${_got_entries} host=${_host}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "restore" "ok" \
            "app" "${APP_NAME}" \
            "archive" "${_arc}" \
            "destination" "${_restored}" \
            "restore_host" "${_host}" \
            "project" "${_proj}" \
            "source_entries" "${_got_entries}" \
            "source_files" "${_got_files}" \
            "archive_members" "${_exp_members}" \
            "archive_files" "${_exp_files}" \
            "verified" "true" \
            "version" "${VERSION}"
    fi
    return 0
}

# =============================================================================
# fb_sudoers_trust_tier() - Classify managed-install trust for print-sudoers
# =============================================================================
#
# Prints one of: production | test_local | unmanaged
# production = executable global managed binary present
# test_local = only local user-bin managed binary
# unmanaged  = neither path executable
#
# ALIGNMENT: requirement-three-layer-privilege-model.md §2.3.1a
# =============================================================================
fb_sudoers_trust_tier() {
    : "${APP_NAME:=folder-backup}"
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"

    # Shell ship unit needs read+execute for the classifying process. Mode 0711
    # is -x but not -r for non-owners → not a usable multi-user production install.
    if [ -r "${GLOBAL_BIN}/${APP_NAME}" ] && [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
        printf '%s' "production"
        return 0
    fi
    if [ -r "${USER_BIN}/${APP_NAME}" ] && [ -x "${USER_BIN}/${APP_NAME}" ]; then
        printf '%s' "test_local"
        return 0
    fi
    printf '%s' "unmanaged"
    return 0
}

# =============================================================================
# fb_sudoers_fragment_text() - Class B: emit draft sudoers text to stdout
# =============================================================================
#
# GENERAL PURPOSE:
# Build the sudoer-file text dual of fb_sudoers_json_text (verbs plus sudoers *).
#
# ALIGNMENT:
# - requirement-sudoer-json-file.md 1.3.0
# - requirement-three-layer-privilege-model.md 1.11.0 AC-25
# - requirement-domain-folder-backup.md
# - INC-20260823-001 (verb-only exact-argv does not match backup <folder>)
#
# Last reviewed: 2026-08-23
# =============================================================================
fb_sudoers_fragment_text() {
    : "${APP_NAME:=folder-backup}"
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"

    _user=$(id -un 2>/dev/null || echo "unknown")
    _tier=$(fb_sudoers_trust_tier)
    _global_path="${GLOBAL_BIN}/${APP_NAME}"
    _local_path="${USER_BIN}/${APP_NAME}"
    _installed=$(fb_default_installed_sudoers_path)
    _purpose="Allow ${_user} to run ${APP_NAME} backup and restore as root."

    if [ "${_tier}" = "production" ]; then
        _trust_banner="# Trust tier: production (global managed binary: ${_global_path})
# Residual: elevating backup/restore as root can read any path the binary can.
# Multi-user: install as ${_installed} (per-user suffix; do not overwrite other users)."
    else
        _trust_banner="# =============================================================================
# WARNING: TEST MODE ONLY — NOT PRODUCTION-SECURE
# Local/unmanaged install: user can rewrite ${_local_path}.
# Uninstall this fragment soon:
#   sudo rm ${_installed}
# Production path: sudo ${APP_NAME} install  → re-emit print-sudoers → re-review → reinstall
# Multi-user: installed name is per-user (${APP_NAME}-<user>) so users do not overwrite each other.
# ============================================================================="
    fi

    cat <<EOF
# Purpose: ${_purpose}
# ${APP_NAME} — ${APP_NAME} backup/restore only (review before install)
# Target user: ${_user}
# Install: sudo install -m 0440 <this-file> ${_installed}
# Validate: sudo visudo -c -f ${_installed}
# Trust tier: ${_tier}
${_trust_banner}
#
# Grant is the project command only. Does NOT elevate ${_local_path}.
# Does NOT allowlist mkdir/cp/tar/rm/install/chmod (complexity weakens security).
# Trailing * = one extra operand (source folder / restore token). Verb-only does not match.
# After elev, the ship unit performs deposit/verify/restore internally.
${_user} ALL=(root) NOPASSWD: ${_global_path} backup *
${_user} ALL=(root) NOPASSWD: ${_global_path} restore *
${_user} ALL=(root) NOPASSWD: ${_global_path} --json backup *
${_user} ALL=(root) NOPASSWD: ${_global_path} --json restore *
EOF
}

# =============================================================================
# fb_sudoers_json_text() - Class B: emit JSON sudoer file to stdout
# =============================================================================
#
# GENERAL PURPOSE:
# JSON sudoer file (requirement-sudoer-json-file). action from SUBMIT_ACTION.
#
# ALIGNMENT: requirement-sudoer-json-file.md 1.3.0 (args verb plus *)
# Last reviewed: 2026-08-23
# =============================================================================
fb_sudoers_json_text() {
    : "${APP_NAME:=folder-backup}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${SUBMIT_ACTION:=add}"

    _user=$(id -un 2>/dev/null || echo "unknown")
    _global_path="${GLOBAL_BIN}/${APP_NAME}"
    _action="${SUBMIT_ACTION}"
    case "${_action}" in
        add|update) ;;
        *) _action="add" ;;
    esac

    cat <<EOF
{
  "schema_version": 1,
  "purpose": "Allow ${_user} to run ${APP_NAME} backup and restore as root.",
  "username": "${_user}",
  "service": "${APP_NAME}",
  "action": "${_action}",
  "commands": [
    {
      "runas": "root",
      "tags": ["NOPASSWD"],
      "path": "${_global_path}",
      "args": ["backup", "*"]
    },
    {
      "runas": "root",
      "tags": ["NOPASSWD"],
      "path": "${_global_path}",
      "args": ["restore", "*"]
    }
  ]
}
EOF
}

# Compact one-line dual of fb_sudoers_json_text (same grant). Legal JSON.
# Sibling sudoer-cli 1.6.1 splits commands[] only on the token },{ — pretty
# emit survives 1.6.2+; compact is the submit/generate handoff so inbound
# still names backup and restore (INC-20260817-001 / 002).
# args include sudoers * (INC-20260823-001).
fb_sudoers_json_text_compact() {
    : "${APP_NAME:=folder-backup}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${SUBMIT_ACTION:=add}"

    _user=$(id -un 2>/dev/null || echo "unknown")
    _global_path="${GLOBAL_BIN}/${APP_NAME}"
    _action="${SUBMIT_ACTION}"
    case "${_action}" in
        add|update) ;;
        *) _action="add" ;;
    esac

    printf '%s\n' "{\"schema_version\":1,\"purpose\":\"Allow ${_user} to run ${APP_NAME} backup and restore as root.\",\"username\":\"${_user}\",\"service\":\"${APP_NAME}\",\"action\":\"${_action}\",\"commands\":[{\"runas\":\"root\",\"tags\":[\"NOPASSWD\"],\"path\":\"${_global_path}\",\"args\":[\"backup\",\"*\"]},{\"runas\":\"root\",\"tags\":[\"NOPASSWD\"],\"path\":\"${_global_path}\",\"args\":[\"restore\",\"*\"]}]}"
}

# =============================================================================
# fb_sudoers_refuse_forbidden_grant() - Fail closed on OS-tool sudoer files
# =============================================================================
#
# ALIGNMENT: requirement-sudoer-json-file.md §2.7 AC-7
# =============================================================================
fb_sudoers_refuse_forbidden_grant() {
    _gf="${1:-}"
    : "${APP_NAME:=folder-backup}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    if [ -z "${_gf}" ] || [ ! -f "${_gf}" ]; then
        out_die "sudoer grant file missing"
    fi
    _gb=$(cat "${_gf}" 2>/dev/null || true)
    case "${_gb}" in
        *"/usr/bin/mkdir"*|*"/bin/mkdir"*|*"/usr/bin/cp"*|*"/bin/cp"*|*"/usr/bin/tar"*|*"/bin/tar"*|*"/bin/rm "*|*"/usr/bin/rm "*|*"/usr/bin/install"*|*"/usr/bin/chmod"*|*"/bin/chmod"*)
            out_die "refusing sudoer grant with OS-tool commands (need ${GLOBAL_BIN}/${APP_NAME} backup|restore only)"
            ;;
    esac
    return 0
}

# Fail closed unless the file still names both elev verbs.
fb_sudoers_verify_grant_verbs() {
    _gf="${1:-}"
    : "${APP_NAME:=folder-backup}"
    if [ -z "${_gf}" ] || [ ! -f "${_gf}" ]; then
        out_die "sudoer file missing (cannot verify backup and restore)"
    fi
    _gb=$(cat "${_gf}" 2>/dev/null || true)
    case "${_gb}" in
        *'"backup"'*) ;;
        *) out_die "Sudoer file is incomplete: it does not allow backup. Path: ${_gf}" ;;
    esac
    case "${_gb}" in
        *'"restore"'*) ;;
        *) out_die "Sudoer file is incomplete: it does not allow restore. Path: ${_gf}" ;;
    esac
    case "${_gb}" in
        *'"*"'*) ;;
        *) out_die "Sudoer file is incomplete: backup and restore need a sudoers operand wildcard (*). Path: ${_gf}" ;;
    esac
    return 0
}

# When sudoer-cli is present, convert must still list both verbs.
# Returns 0 if convert kept both; 1 if sudoer-cli is absent (caller may skip).
fb_sudoers_verify_sibling_convert() {
    _gf="${1:-}"
    : "${APP_NAME:=folder-backup}"
    _cli=""
    if _cli=$(fb_detect_sudoer_cli); then
        :
    else
        return 1
    fi
    # Stub CLIs used in suite only implement add/update. Skip convert unless
    # help lists json-to-sudoers (real sudoer-cli).
    _help=$("${_cli}" help 2>/dev/null || true)
    case "${_help}" in
        *json-to-sudoers*) ;;
        *) return 1 ;;
    esac
    _outf=$(util_mktemp sudoer-conv)
    _cerr=$(util_mktemp sudoer-conv-err)
    if ! "${_cli}" json-to-sudoers --file "${_gf}" --out "${_outf}" >/dev/null 2>"${_cerr}"; then
        _emsg=$(cat "${_cerr}" 2>/dev/null || true)
        rm -f "${_outf}" "${_cerr}"
        case "${_emsg}" in
            *"well-known system binary"*|*"test-well-known-binary"*)
                # Isolated/test GLOBAL_BIN is user-rewritable; sibling 1.17+
                # correctly refuses convert. Skip — do not block generate.
                return 1
                ;;
        esac
        out_die "sudoer-cli json-to-sudoers failed for ${_gf}. The file is not safe to submit."
    fi
    rm -f "${_cerr}"
    _txt=$(cat "${_outf}" 2>/dev/null || true)
    rm -f "${_outf}"
    case "${_txt}" in
        *" ${APP_NAME} backup"*|*"/${APP_NAME} backup"*) ;;
        *) out_die "sudoer-cli convert dropped backup from ${_gf}. Do not submit this file. Install sudoer-cli 1.6.2+ or regenerate with ${APP_NAME} generate-sudoer-request." ;;
    esac
    case "${_txt}" in
        *" ${APP_NAME} restore"*|*"/${APP_NAME} restore"*) ;;
        *) out_die "sudoer-cli convert dropped restore from ${_gf}. Do not submit this file. Install sudoer-cli 1.6.2+ or regenerate with ${APP_NAME} generate-sudoer-request." ;;
    esac
    return 0
}

# =============================================================================
# fb_print_sudoers() - Emit narrow sudoers fragment (does NOT write /etc)
# =============================================================================
#
# ALIGNMENT:
# - requirement-domain-folder-backup.md
# - requirement-three-layer-privilege-model.md
# - requirement-folder-archive-backup.md (deposit + restore stage fetch)
#
# Last reviewed: 2026-08-14
# =============================================================================
fb_print_sudoers() {
    : "${APP_NAME:=folder-backup}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${BACKUP_ROOT:=/var/backup}"
    : "${BACKUP_NOTATION:=folder-backup}"
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${ALLOW_TEST_LOCAL_SUDOERS:=0}"

    _user=$(id -un 2>/dev/null || echo "unknown")
    _dest="${BACKUP_ROOT}/${BACKUP_NOTATION}"
    _out_path="${1:-}"
    _tier=$(fb_sudoers_trust_tier)
    _test_mode="false"
    _global_path="${GLOBAL_BIN}/${APP_NAME}"

    if [ "${_tier}" != "production" ]; then
        _test_mode="true"
        if [ "${ALLOW_TEST_LOCAL_SUDOERS}" -ne 1 ]; then
            out_die "print-sudoers trust tier is ${_tier} (not production). Local/user-rewritable install is TEST MODE ONLY. Prefer: sudo ${APP_NAME} install  (global ${_global_path}). To emit a test fragment anyway: ${APP_NAME} print-sudoers --allow-test-local [path]  or ALLOW_TEST_LOCAL_SUDOERS=1"
        fi
    fi

    _installed=$(fb_default_installed_sudoers_path)
    _draft_default=$(fb_default_project_sudoers_path)
    _fragment=$(fb_sudoers_fragment_text)

    if [ "${_test_mode}" = "true" ] && [ "${JSON}" -eq 0 ]; then
        out_warn "TEST MODE ONLY: trust tier=${_tier}. Uninstall ${_installed} soon. Prefer global install for production."
    fi

    if [ -n "${_out_path}" ]; then
        _dir=$(dirname -- "${_out_path}")
        if [ ! -d "${_dir}" ]; then
            mkdir -p "${_dir}" || out_die "Cannot create ${_dir}"
        fi
        printf '%s\n' "${_fragment}" > "${_out_path}" || out_die "Cannot write ${_out_path}"
        _json_path="${_out_path}.json"
        fb_sudoers_json_text > "${_json_path}" || out_die "Cannot write ${_json_path}"
        out_success "Wrote sudoers fragment to ${_out_path}"
        out_info "JSON sudoer file: ${_json_path}"
        out_info "Admin: sudo visudo -c -f ${_out_path}"
        out_info "Admin: sudo install -m 0440 ${_out_path} ${_installed}"
        if [ "${_test_mode}" = "true" ]; then
            out_warn "Admin (test mode): plan uninstall soon → sudo rm ${_installed}"
        fi
        if [ "${JSON}" -eq 1 ]; then
            out_json "print-sudoers" "written" \
                "path" "${_out_path}" \
                "user" "${_user}" \
                "installed_path" "${_installed}" \
                "dest" "${_dest}" \
                "trust_tier" "${_tier}" \
                "test_mode" "${_test_mode}"
        fi
        return 0
    fi

    if [ "${JSON}" -eq 1 ]; then
        # Avoid huge JSON with full fragment; give path guidance
        out_json "print-sudoers" "use human mode or path arg to capture fragment" \
            "user" "${_user}" \
            "dest" "${_dest}" \
            "installed_path" "${_installed}" \
            "trust_tier" "${_tier}" \
            "test_mode" "${_test_mode}" \
            "hint" "${APP_NAME} print-sudoers --allow-test-local ${_draft_default}"
        return 0
    fi

    out_info "Sudoers fragment for user ${_user} → ${GLOBAL_BIN}/${APP_NAME} backup *|restore * (trust_tier=${_tier})"
    out_warn "Host Type 1 still uses sudo mkdir/cp until backup/restore re-exec; installing this fragment now will fail those steps."
    out_info "Admin steps: review → visudo -c -f FILE → install -m 0440 FILE ${_installed}"
    out_empty_line
    out_plain "${_fragment}"
    out_empty_line
    out_info "Tip: ${APP_NAME} print-sudoers ${_draft_default}"
    out_info "Admin script: ${APP_NAME} print-sudoers-install-script"
}

# =============================================================================
# fb_detect_sudoer_cli() - Class B: path of sudoer-cli, or fail
# =============================================================================
#
# GENERAL PURPOSE:
# Locate the sudoer-cli binary (env override, global bin, user bin, PATH).
# Does not claim the approval queues exist.
#
# ALIGNMENT:
# - requirement-domain-folder-backup.md
# - requirement-three-layer-privilege-model.md
#
# Last reviewed: 2026-08-14
# =============================================================================
fb_detect_sudoer_cli() {
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${SUDOER_CLI:=}"

    if [ -n "${SUDOER_CLI}" ]; then
        if [ -x "${SUDOER_CLI}" ]; then
            printf '%s' "${SUDOER_CLI}"
            return 0
        fi
        return 1
    fi
    if [ -x "${GLOBAL_BIN}/sudoer-cli" ]; then
        printf '%s' "${GLOBAL_BIN}/sudoer-cli"
        return 0
    fi
    if [ -x "${USER_BIN}/sudoer-cli" ]; then
        printf '%s' "${USER_BIN}/sudoer-cli"
        return 0
    fi
    _found=$(command -v sudoer-cli 2>/dev/null || true)
    if [ -n "${_found}" ] && [ -x "${_found}" ]; then
        printf '%s' "${_found}"
        return 0
    fi
    return 1
}

# =============================================================================
# fb_detect_sudoer_adm() - Class B: sudoer-adm login if present
# =============================================================================
#
# GENERAL PURPOSE:
# Probe whether the least-privilege approver account exists (id).
# Account name defaults to sudoer-adm; override with SUDOER_ADM_USER.
#
# ALIGNMENT:
# - requirement-domain-folder-backup.md
# - requirement-three-layer-privilege-model.md
#
# Last reviewed: 2026-08-14
# =============================================================================
fb_detect_sudoer_adm() {
    : "${SUDOER_ADM_USER:=sudoer-adm}"
    if id "${SUDOER_ADM_USER}" >/dev/null 2>&1; then
        printf '%s' "${SUDOER_ADM_USER}"
        return 0
    fi
    return 1
}

# =============================================================================
# fb_detect_sudoer_inbound() - Class B: inbound approval dir if present
# =============================================================================
#
# GENERAL PURPOSE:
# Find the sibling public inbound (preferred /var/sudoer-cli/sudoer-request).
# Type 0 MUST NOT mkdir. Order: env override → public → F4 view → legacy.
#
# ALIGNMENT:
# - requirement-three-layer-privilege-model.md §2.3.3c (AC-16)
# - requirement-domain-folder-backup.md
#
# Last reviewed: 2026-08-15
# =============================================================================
fb_detect_sudoer_inbound() {
    : "${SUDOER_ADM_USER:=sudoer-adm}"
    : "${SUDOER_QUEUE_INBOUND:=}"
    : "${SUDOER_APPROVAL_APP:=sudoer-cli}"
    : "${SUDOER_INBOUND_BASENAME:=sudoer-request}"
    : "${SUDOER_PUBLIC_ROOT:=/var/${SUDOER_APPROVAL_APP}}"

    if [ -n "${SUDOER_QUEUE_INBOUND}" ] && [ -d "${SUDOER_QUEUE_INBOUND}" ]; then
        printf '%s' "${SUDOER_QUEUE_INBOUND}"
        return 0
    fi

    _home=""
    if command -v getent >/dev/null 2>&1; then
        _home=$(getent passwd "${SUDOER_ADM_USER}" 2>/dev/null | cut -d: -f6)
    fi
    if [ -z "${_home}" ] && [ -r /etc/passwd ]; then
        _home=$(awk -F: -v u="${SUDOER_ADM_USER}" '$1==u {print $6; exit}' /etc/passwd 2>/dev/null)
    fi

    for _cand in \
        "${SUDOER_PUBLIC_ROOT}/${SUDOER_INBOUND_BASENAME}" \
        ${_home:+"${_home}/${SUDOER_INBOUND_BASENAME}"} \
        ${_home:+"${_home}/sudoer-approving"} \
        "/etc/${SUDOER_ADM_USER}/sudoer-approving" \
        "/home/${SUDOER_ADM_USER}/sudoer-approving"
    do
        if [ -n "${_cand}" ] && [ -d "${_cand}" ]; then
            printf '%s' "${_cand}"
            return 0
        fi
    done
    return 1
}

# =============================================================================
# fb_sudoer_queue_root_from_inbound() - parent of real public inbound, or test override
# =============================================================================
# MUST NOT treat a legacy …/sudoer-approving parent as the public queue root.
# =============================================================================
fb_sudoer_queue_root_from_inbound() {
    _in="${1:-}"
    [ -n "${_in}" ] || return 1
    _base=$(basename -- "${_in}")
    if [ -n "${SUDOER_QUEUE_INBOUND}" ] && [ "${_in}" = "${SUDOER_QUEUE_INBOUND}" ]; then
        dirname -- "${_in}"
        return 0
    fi
    if [ "${_base}" = "${SUDOER_INBOUND_BASENAME:-sudoer-request}" ]; then
        _real="${_in}"
        if command -v readlink >/dev/null 2>&1; then
            _resolved=$(readlink -f "${_in}" 2>/dev/null || true)
            [ -n "${_resolved}" ] && _real="${_resolved}"
        fi
        dirname -- "${_real}"
        return 0
    fi
    return 1
}

# =============================================================================
# fb_sudoers_require_emit_trust() - Fail-closed unless production or test-allow
# =============================================================================
fb_sudoers_require_emit_trust() {
    : "${APP_NAME:=folder-backup}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${ALLOW_TEST_LOCAL_SUDOERS:=0}"
    _cmd="${1:-submit-sudoer-request}"
    _tier=$(fb_sudoers_trust_tier)
    if [ "${_tier}" != "production" ]; then
        if [ "${ALLOW_TEST_LOCAL_SUDOERS}" -ne 1 ]; then
            out_die "${_cmd} trust tier is ${_tier} (not production). Prefer: sudo ${APP_NAME} install  (global ${GLOBAL_BIN}/${APP_NAME}). To emit a test file: ${APP_NAME} ${_cmd} --allow-test-local  or ALLOW_TEST_LOCAL_SUDOERS=1"
        fi
    fi
}

# =============================================================================
# fb_generate_sudoer_request() - Type 0: write a local JSON grant you can verify
# =============================================================================
#
# GENERAL PURPOSE:
# Write this product's sudoer JSON to a local path (default under ~/.config),
# verify backup + restore are present, and when sudoer-cli exists convert the
# file so a dropped verb fails here — not after inbound queue. Does not write
# /etc, does not write inbound, does not mkdir inbound.
#
# ALIGNMENT:
# - requirement-three-layer-privilege-model.md §2.3.3d
# - requirement-sudoer-json-file.md
# - requirement-domain-folder-backup.md
# - INC-20260817-002 (operator-readable; incomplete JSON is not a standing class)
#
# Last reviewed: 2026-08-17
# =============================================================================
fb_generate_sudoer_request() {
    : "${APP_NAME:=folder-backup}"
    : "${JSON:=0}"
    : "${HOME:=/tmp}"
    : "${SUBMIT_ACTION:=add}"
    : "${SUBMIT_ACTION_EXPLICIT:=0}"

    _out_path="${1:-}"
    _user=$(id -un 2>/dev/null || echo "unknown")

    _host_path=""
    _host_present="false"
    if _host_path=$(fb_probe_current_user_host_sudoers); then
        _host_present="true"
    else
        _host_path=""
    fi
    if [ "${SUBMIT_ACTION_EXPLICIT}" -ne 1 ]; then
        if [ "${_host_present}" = "true" ]; then
            SUBMIT_ACTION="update"
        else
            SUBMIT_ACTION="add"
        fi
    fi
    case "${SUBMIT_ACTION}" in
        add|update) ;;
        *) out_die "generate-sudoer-request action must be add or update (got ${SUBMIT_ACTION})" ;;
    esac

    fb_sudoers_require_emit_trust "generate-sudoer-request"

    if [ -z "${_out_path}" ]; then
        _out_path=$(fb_default_sudoer_request_path)
    fi
    case "${_out_path}" in
        /etc|/etc/*)
            out_die "generate-sudoer-request refuses to write under /etc (Type 0). Use a path under \$HOME or /dev/shm."
            ;;
        /var/sudoer-cli|/var/sudoer-cli/*)
            out_die "generate-sudoer-request does not write inbound. Write a local file, then: ${APP_NAME} submit-sudoer-request <path>"
            ;;
    esac
    if [ -e "${_out_path}" ] && [ -L "${_out_path}" ]; then
        out_die "refusing symlink dest: ${_out_path}"
    fi
    if [ -d "${_out_path}" ]; then
        out_die "generate dest is a directory: ${_out_path}"
    fi
    _dir=$(dirname -- "${_out_path}")
    if [ ! -d "${_dir}" ]; then
        mkdir -p "${_dir}" || out_die "Cannot create ${_dir}"
    fi

    fb_sudoers_json_text_compact >"${_out_path}" || out_die "Cannot write ${_out_path}"
    chmod 0644 "${_out_path}" 2>/dev/null || true
    if [ ! -r "${_out_path}" ]; then
        out_die "generated sudoer file is not readable: ${_out_path}"
    fi
    fb_sudoers_refuse_forbidden_grant "${_out_path}"
    fb_sudoers_verify_grant_verbs "${_out_path}"

    _convert="skipped"
    if fb_sudoers_verify_sibling_convert "${_out_path}"; then
        _convert="ok"
    fi

    if [ "${JSON}" -eq 1 ]; then
        out_json "generate-sudoer-request" "written" \
            "path" "${_out_path}" \
            "readable" "true" \
            "verified" "true" \
            "convert_checked" "$([ "${_convert}" = "ok" ] && echo true || echo false)" \
            "action" "${SUBMIT_ACTION}" \
            "host_fragment_present" "${_host_present}" \
            "user" "${_user}"
        return 0
    fi

    out_success "Wrote verified sudoer file to ${_out_path}"
    out_info "Grant allows: ${APP_NAME} backup and restore (action=${SUBMIT_ACTION})"
    if [ "${_convert}" = "ok" ]; then
        out_info "Convert check: backup and restore still present after sudoer-cli json-to-sudoers"
    else
        out_info "Convert check: skipped (no sudoer-cli, or convert refused a non-system path). File still lists backup and restore."
    fi
    out_info "Review the file, then submit it:"
    out_info "   ${APP_NAME} submit-sudoer-request ${_out_path}"
}

# =============================================================================
# fb_submit_sudoer_request() - Type 0: queue this product's sudoers for approval
# =============================================================================
#
# GENERAL PURPOSE:
# Detect sudoer-cli and sudoer-adm, emit (or accept) a self-scoped sudoers
# fragment, and submit it via sudoer-cli so a JSON request lands in the
# public inbound (/var/sudoer-cli/sudoer-request). Does not write /etc
# and does not mkdir inbound. Approver (sudoer-adm) still must approve.
# Default emit is the compact verified grant (same as generate-sudoer-request).
#
# ALIGNMENT:
# - requirement-domain-folder-backup.md
# - requirement-three-layer-privilege-model.md
# - requirement-sudoer-json-file.md (JSON grant body: PRJ_NAME only)
# - requirement-shell-cli-interface.md
#
# Last reviewed: 2026-08-17
# =============================================================================
fb_submit_sudoer_request() {
    : "${APP_NAME:=folder-backup}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${HOME:=/tmp}"
    : "${SUDOER_ADM_USER:=sudoer-adm}"
    : "${SUBMIT_PURPOSE:=}"
    : "${SUBMIT_ACTION:=add}"
    : "${SUBMIT_ACTION_EXPLICIT:=0}"
    : "${EFFECTIVE_STORAGE_DIR:=}"

    _src_file="${1:-}"
    _user=$(id -un 2>/dev/null || echo "unknown")
    _purpose="${SUBMIT_PURPOSE}"
    if [ -z "${_purpose}" ]; then
        _purpose="Allow ${_user} to run ${APP_NAME} backup and restore as root."
    fi

    _host_path=""
    _host_present="false"
    if _host_path=$(fb_probe_current_user_host_sudoers); then
        _host_present="true"
    else
        _host_path=""
    fi
    _action_source="explicit"
    if [ "${SUBMIT_ACTION_EXPLICIT}" -ne 1 ]; then
        _action_source="detected"
        if [ "${_host_present}" = "true" ]; then
            SUBMIT_ACTION="update"
        else
            SUBMIT_ACTION="add"
        fi
    fi
    case "${SUBMIT_ACTION}" in
        add|update) ;;
        *) out_die "submit-sudoer-request action must be add or update (got ${SUBMIT_ACTION})" ;;
    esac

    if [ -n "${_src_file}" ]; then
        if [ ! -f "${_src_file}" ]; then
            out_die "sudoers file not found: ${_src_file}"
        fi
        if [ -L "${_src_file}" ]; then
            out_die "refusing symlink sudoers input: ${_src_file}"
        fi
        fb_sudoers_refuse_forbidden_grant "${_src_file}"
    fi

    _cli=""
    if _cli=$(fb_detect_sudoer_cli); then
        :
    else
        out_die "sudoer-cli not found (set SUDOER_CLI or install sudoer-cli to ${GLOBAL_BIN:-/usr/local/bin}/sudoer-cli). Submit is Type 0 compose — this CLI does not write /etc."
    fi

    _adm=""
    if _adm=$(fb_detect_sudoer_adm); then
        :
    else
        out_die "sudoer-adm not found (id ${SUDOER_ADM_USER} failed). Ask an admin to run: sudo sudoer-cli setup"
    fi

    : "${SUDOER_PUBLIC_ROOT:=/var/${SUDOER_APPROVAL_APP:-sudoer-cli}}"
    _inbound=""
    if _inbound=$(fb_detect_sudoer_inbound); then
        :
    else
        out_die "sudoer inbound queue not found (preferred ${SUDOER_PUBLIC_ROOT}/sudoer-request). Ask an admin to run: sudo sudoer-cli setup"
    fi
    if [ ! -w "${_inbound}" ]; then
        out_die "sudoer inbound not writable: ${_inbound}. Check mode 3773 on public inbound (owner ${_adm})."
    fi

    _tmp=""
    if [ -n "${_src_file}" ]; then
        if [ ! -f "${_src_file}" ]; then
            out_die "sudoers file not found: ${_src_file}"
        fi
        if [ -L "${_src_file}" ]; then
            out_die "refusing symlink sudoers input: ${_src_file}"
        fi
        _tmp="${_src_file}"
        _cleanup_tmp=0
    else
        fb_sudoers_require_emit_trust "submit-sudoer-request"
        if [ -z "${EFFECTIVE_STORAGE_DIR}" ]; then
            EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
        fi
        _tmp=$(util_mktemp sudoer)
        fb_sudoers_json_text_compact >"${_tmp}" || out_die "cannot write temp sudoer JSON ${_tmp}"
        _cleanup_tmp=1
    fi
    fb_sudoers_refuse_forbidden_grant "${_tmp}"
    fb_sudoers_verify_grant_verbs "${_tmp}"
    fb_sudoers_verify_sibling_convert "${_tmp}" || true

    # Point sudoer-cli at the public queue root (parent of real inbound).
    # Do not export a legacy sudoer-approving parent as the public trio root.
    # When inbound is an env override, also pass --queue-root so a real
    # sudoer-cli cannot fall back to /var/sudoer-cli.
    _queue_root_flag=""
    if _qr=$(fb_sudoer_queue_root_from_inbound "${_inbound}"); then
        SUDOER_CLI_QUEUE_ROOT="${_qr}"
        export SUDOER_CLI_QUEUE_ROOT
        if [ -n "${SUDOER_QUEUE_INBOUND}" ] && [ "${_inbound}" = "${SUDOER_QUEUE_INBOUND}" ]; then
            LPU_HOME="${_qr}"
            export LPU_HOME
            _queue_root_flag="${_qr}"
        fi
    fi

    _verb="add-sudoer-request"
    if [ "${SUBMIT_ACTION}" = "update" ]; then
        _verb="update-sudoer-request"
    fi

    _errf=$(util_mktemp sudoer-err)
    _out=""
    _rc=0
    _sr_json=""
    if [ "${JSON}" -eq 1 ]; then
        _sr_json="--json"
    fi
    if [ -n "${_queue_root_flag}" ]; then
        # shellcheck disable=SC2086
        _out=$("${_cli}" ${_sr_json} --queue-root "${_queue_root_flag}" "${_verb}" --file "${_tmp}" --purpose "${_purpose}" --service "${APP_NAME}" 2>"${_errf}")
        _rc=$?
    else
        # shellcheck disable=SC2086
        _out=$("${_cli}" ${_sr_json} "${_verb}" --file "${_tmp}" --purpose "${_purpose}" --service "${APP_NAME}" 2>"${_errf}")
        _rc=$?
    fi
    _err=$(cat "${_errf}" 2>/dev/null || true)
    rm -f "${_errf}"
    if [ "${_cleanup_tmp}" -eq 1 ]; then
        rm -f "${_tmp}"
    fi

    if [ "${_rc}" -ne 0 ]; then
        if [ -n "${_err}" ]; then
            out_die "sudoer-cli ${_verb} failed: ${_err}"
        fi
        out_die "sudoer-cli ${_verb} failed (exit ${_rc})"
    fi

    _rid=$(printf '%s\n' "${_out}" | sed -n 's/.*"request_id":"\([^"]*\)".*/\1/p')
    if [ -z "${_rid}" ]; then
        _rid=$(printf '%s\n' "${_out}" | sed -n 's/.*request_id=\([^[:space:]]*\).*/\1/p')
    fi

    # When inbound is readable, queued body MUST still name both elev verbs.
    # Purpose text and [OK] submitted are not completeness. INC-20260817-001.
    if [ -n "${_rid}" ] && [ -r "${_inbound}/${_rid}" ]; then
        _ibody=$(cat "${_inbound}/${_rid}" 2>/dev/null || true)
        case "${_ibody}" in
            *'"backup"'*) ;;
            *) out_die "Queued sudo request is incomplete: it allows restore but not backup. Do not approve ${_rid}. Reject or leave it pending. Write a verified file, then submit that file: ${APP_NAME} generate-sudoer-request && ${APP_NAME} submit-sudoer-request <path>" ;;
        esac
        case "${_ibody}" in
            *'"restore"'*) ;;
            *) out_die "Queued sudo request is incomplete: it allows backup but not restore. Do not approve ${_rid}. Reject or leave it pending. Write a verified file, then submit that file: ${APP_NAME} generate-sudoer-request && ${APP_NAME} submit-sudoer-request <path>" ;;
        esac
    fi

    if [ "${JSON}" -eq 1 ]; then
        out_json "submit-sudoer-request" "submitted" \
            "request_id" "${_rid}" \
            "action" "${SUBMIT_ACTION}" \
            "action_source" "${_action_source}" \
            "host_fragment_present" "${_host_present}" \
            "host_fragment_path" "${_host_path}" \
            "service" "${APP_NAME}" \
            "user" "${_user}" \
            "sudoer_cli" "${_cli}" \
            "sudoer_adm" "${_adm}" \
            "inbound" "${_inbound}"
        return 0
    fi

    out_success "Submitted ${SUBMIT_ACTION} request via ${_cli}"
    if [ -n "${_rid}" ]; then
        out_info "request_id=${_rid}"
    fi
    if [ "${_host_present}" = "true" ]; then
        out_info "host_fragment=${_host_path}  (action=${SUBMIT_ACTION} ${_action_source})"
    else
        out_info "host_fragment=absent  (action=${SUBMIT_ACTION} ${_action_source})"
    fi
    out_info "inbound=${_inbound}  (approver: ${_adm})"
    out_info "This CLI did not write /etc. Approver must approve the request."
    return 0
}

# =============================================================================
# fb_current_login_user() - Class B: invoking login name for path suffixes
# =============================================================================
fb_current_login_user() {
    id -un 2>/dev/null || echo "unknown"
}

# =============================================================================
# fb_default_project_sudoers_path() - Class B: default project-sudoers-file path
# =============================================================================
# Per-user draft: ${HOME}/.config/${APP_NAME}/sudoers.fragment-<user>
# Multi-user: each login keeps a distinct draft filename (not a shared basename).
# =============================================================================
fb_default_project_sudoers_path() {
    : "${APP_NAME:=folder-backup}"
    : "${HOME:=/tmp}"
    _user=$(fb_current_login_user)
    printf '%s' "${HOME}/.config/${APP_NAME}/sudoers.fragment-${_user}"
}

# Local verified JSON grant for generate-sudoer-request (not inbound).
fb_default_sudoer_request_path() {
    : "${APP_NAME:=folder-backup}"
    : "${HOME:=/tmp}"
    _user=$(fb_current_login_user)
    printf '%s' "${HOME}/.config/${APP_NAME}/sudoer-request-${_user}.json"
}

# =============================================================================
# fb_default_installed_sudoers_path() - Class B: host /etc/sudoers.d path
# =============================================================================
# Per-user installed name: /etc/sudoers.d/${APP_NAME}-<user>
# Prevents multi-user admin installs from overwriting another user's fragment.
# =============================================================================
fb_sudoers_d_dir() {
    : "${SUDOERS_D_DIR:=/etc/sudoers.d}"
    printf '%s' "${SUDOERS_D_DIR}"
}

fb_default_installed_sudoers_path() {
    : "${APP_NAME:=folder-backup}"
    _user=$(fb_current_login_user)
    printf '%s' "$(fb_sudoers_d_dir)/${APP_NAME}-${_user}"
}

# =============================================================================
# fb_legacy_installed_sudoers_path() - Class B: pre-user-suffix host path
# =============================================================================
fb_legacy_installed_sudoers_path() {
    : "${APP_NAME:=folder-backup}"
    printf '%s' "$(fb_sudoers_d_dir)/${APP_NAME}"
}

# =============================================================================
# fb_list_project_sudoers_drafts() - Class B: list draft paths under config
# =============================================================================
# Emits one absolute path per line: legacy sudoers.fragment then sudoers.fragment-*.
# ALIGNMENT: term project-sudoers-file · multi-user remove-project-sudoers
# =============================================================================
fb_list_project_sudoers_drafts() {
    : "${APP_NAME:=folder-backup}"
    : "${HOME:=/tmp}"
    _dir="${HOME}/.config/${APP_NAME}"
    if [ ! -d "${_dir}" ]; then
        return 0
    fi
    # Legacy un-suffixed draft (pre multi-user naming)
    if [ -f "${_dir}/sudoers.fragment" ]; then
        printf '%s\n' "${_dir}/sudoers.fragment"
    fi
    for _f in "${_dir}"/sudoers.fragment-*; do
        if [ -f "${_f}" ]; then
            case "${_f}" in
                *.json) continue ;;
            esac
            printf '%s\n' "${_f}"
        fi
    done
    return 0
}

# =============================================================================
# fb_list_host_sudoers_fragments() - Class B: list readable host elev paths
# =============================================================================
# Lists /etc/sudoers.d/${APP_NAME} (legacy) and /etc/sudoers.d/${APP_NAME}-*
# when present (probe-only; Type 0 never deletes them).
# =============================================================================
fb_list_host_sudoers_fragments() {
    : "${APP_NAME:=folder-backup}"
    _dir=$(fb_sudoers_d_dir)
    _legacy=$(fb_legacy_installed_sudoers_path)
    if [ -e "${_legacy}" ]; then
        printf '%s\n' "${_legacy}"
    fi
    for _f in "${_dir}"/"${APP_NAME}"-*; do
        if [ -e "${_f}" ]; then
            printf '%s\n' "${_f}"
        fi
    done
    return 0
}

# =============================================================================
# fb_probe_current_user_host_sudoers() - Class B: this user's installed fragment
# =============================================================================
# Prefer per-user ${SUDOERS_D_DIR}/${APP_NAME}-<user>, then legacy unsuffixed.
# Other users' ${APP_NAME}-<other> files do not count.
# Type 0: test -e first (works when the dir is searchable). If the dir is
# 0750/unreadable, try sudo -n test -e (no password; miss → stay-honest absent).
# Prints the first existing path; exit 1 if none found.
# =============================================================================
fb_host_sudoers_exists() {
    _hp="${1:-}"
    [ -n "${_hp}" ] || return 1
    if [ -e "${_hp}" ]; then
        return 0
    fi
    if command -v sudo >/dev/null 2>&1; then
        sudo -n test -e "${_hp}" >/dev/null 2>&1 && return 0
    fi
    return 1
}

fb_probe_current_user_host_sudoers() {
    _per=$(fb_default_installed_sudoers_path)
    _leg=$(fb_legacy_installed_sudoers_path)
    if fb_host_sudoers_exists "${_per}"; then
        printf '%s' "${_per}"
        return 0
    fi
    if [ "${_leg}" != "${_per}" ] && fb_host_sudoers_exists "${_leg}"; then
        printf '%s' "${_leg}"
        return 0
    fi
    return 1
}

# =============================================================================
# fb_default_sudoers_admin_script_path() - Class B: admin install script path
# =============================================================================
#
# Prefer /dev/shm (volatile, multi-user handoff); else EFFECTIVE_STORAGE_DIR /tmp.
# ALIGNMENT: term project-sudoers-file · requirement-three-layer-privilege-model
# =============================================================================
fb_default_sudoers_admin_script_path() {
    : "${APP_NAME:=folder-backup}"
    _user=$(fb_current_login_user)
    _name="${APP_NAME}-${_user}-sudoers-admin.sh"
    if [ -d "/dev/shm" ] && [ -w "/dev/shm" ]; then
        printf '%s' "/dev/shm/${_name}"
        return 0
    fi
    if [ -n "${EFFECTIVE_STORAGE_DIR:-}" ] && [ -d "${EFFECTIVE_STORAGE_DIR}" ] && [ -w "${EFFECTIVE_STORAGE_DIR}" ]; then
        printf '%s' "${EFFECTIVE_STORAGE_DIR}/${_name}"
        return 0
    fi
    printf '%s' "/tmp/${_name}"
    return 0
}

# =============================================================================
# fb_print_sudoers_install_script() - Type 0: emit admin install/uninstall script
# =============================================================================
#
# GENERAL PURPOSE:
# 1) Refresh project-sudoers-file (draft) via fb_print_sudoers
# 2) Write a shell script under /dev/shm (or temp) for an account WITH sudo
#    to install | uninstall | replace the fragment under /etc/sudoers.d/
# Does NOT write /etc itself.
#
# ALIGNMENT:
# - term project-sudoers-file
# - requirement-three-layer-privilege-model.md
#
# Last reviewed: 2026-08-09
# =============================================================================
fb_print_sudoers_install_script() {
    : "${APP_NAME:=folder-backup}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${HOME:=/tmp}"
    : "${BACKUP_ROOT:=/var/backup}"
    : "${BACKUP_NOTATION:=folder-backup}"
    : "${ALLOW_TEST_LOCAL_SUDOERS:=0}"

    _user=$(fb_current_login_user)
    _draft=$(fb_default_project_sudoers_path)
    _script_out="${1:-}"
    if [ -z "${_script_out}" ]; then
        _script_out=$(fb_default_sudoers_admin_script_path)
    fi
    _installed=$(fb_default_installed_sudoers_path)
    _legacy=$(fb_legacy_installed_sudoers_path)
    _deposit="${BACKUP_ROOT}/${BACKUP_NOTATION}"
    _tier=$(fb_sudoers_trust_tier)

    # Refresh project-sudoers-file first (same trust gate as print-sudoers)
    fb_print_sudoers "${_draft}" || return $?

    _script_dir=$(dirname -- "${_script_out}")
    if [ ! -d "${_script_dir}" ]; then
        mkdir -p "${_script_dir}" || out_die "Cannot create ${_script_dir}"
    fi

    # Refuse writing admin script under /etc
    case "${_script_out}" in
        /etc/*|/etc)
            out_die "Refusing to write admin script under /etc (Type 0). Use /dev/shm or temp path."
            ;;
    esac

    cat > "${_script_out}" <<EOF
#!/bin/sh
# =============================================================================
# ${APP_NAME} — admin sudoers install / uninstall script
# Generated by: ${APP_NAME} print-sudoers-install-script
# Target user (fragment User lines): ${_user}
# Trust tier at generation: ${_tier}
# Project sudoers file (draft): ${_draft}
# Installed path (per-user): ${_installed}
# Legacy shared path (pre multi-user naming): ${_legacy}
#
# RUN AS ROOT (or via sudo), after switching to an account with sudo rights:
#   sudo sh ${_script_out} install     # visudo-check draft → install 0440
#   sudo sh ${_script_out} uninstall   # remove THIS user's installed fragment
#   sudo sh ${_script_out} replace     # uninstall then install (refresh host fragment)
#
# Multi-user: installed path includes the user suffix so install for user A
# does not overwrite /etc/sudoers.d/${APP_NAME}-B for user B.
# This script NEVER embeds passwords. Review draft before install.
# Type 0 CLI must not run this with residual agent power as a silent /etc write.
# =============================================================================
set -u

APP_NAME="${APP_NAME}"
PROJECT_SUDOERS_FILE="${_draft}"
INSTALLED_SUDOERS="${_installed}"
LEGACY_INSTALLED_SUDOERS="${_legacy}"
DEPOSIT_DIR="${_deposit}"
GEN_USER="${_user}"
GEN_TIER="${_tier}"

die() { printf '%s\\n' "ERROR: \$*" >&2; exit 1; }
info() { printf '%s\\n' "\$*"; }

require_root() {
    if [ "\$(id -u 2>/dev/null || echo 1)" -ne 0 ]; then
        die "Must run as root (e.g. sudo sh \$0 install). Current uid=\$(id -u)."
    fi
}

cmd_install() {
    require_root
    [ -f "\${PROJECT_SUDOERS_FILE}" ] || die "Missing project sudoers file: \${PROJECT_SUDOERS_FILE} — regenerate with: ${APP_NAME} print-sudoers \${PROJECT_SUDOERS_FILE}"
    if command -v visudo >/dev/null 2>&1; then
        visudo -c -f "\${PROJECT_SUDOERS_FILE}" || die "visudo -c failed on draft"
    else
        info "WARN: visudo not found; skipping syntax check (install carefully)"
    fi
    install -m 0440 -o root -g root "\${PROJECT_SUDOERS_FILE}" "\${INSTALLED_SUDOERS}" \\
        || die "install to \${INSTALLED_SUDOERS} failed"
    if command -v visudo >/dev/null 2>&1; then
        visudo -c -f "\${INSTALLED_SUDOERS}" || die "visudo -c failed on installed file — removing"
    fi
    mkdir -p "\${DEPOSIT_DIR}" 2>/dev/null || true
    chmod 0755 "\${DEPOSIT_DIR}" 2>/dev/null || true
    info "OK: installed \${INSTALLED_SUDOERS} (mode 0440) from \${PROJECT_SUDOERS_FILE}"
    info "Fragment target user at generation: \${GEN_USER} (trust_tier=\${GEN_TIER})"
    info "Multi-user note: other users install to /etc/sudoers.d/\${APP_NAME}-<their-user> (no overwrite)"
    if [ -e "\${LEGACY_INSTALLED_SUDOERS}" ] && [ "\${LEGACY_INSTALLED_SUDOERS}" != "\${INSTALLED_SUDOERS}" ]; then
        info "WARN: legacy shared fragment still present: \${LEGACY_INSTALLED_SUDOERS}"
        info "      Consider admin review/remove if migrating to per-user names."
    fi
    if [ "\${GEN_TIER}" != "production" ]; then
        info "WARN: TEST MODE trust tier — plan uninstall soon: sudo sh \$0 uninstall"
    fi
}

cmd_uninstall() {
    require_root
    if [ ! -e "\${INSTALLED_SUDOERS}" ]; then
        info "OK: \${INSTALLED_SUDOERS} already absent (nothing to uninstall)"
    else
        rm -f "\${INSTALLED_SUDOERS}" || die "Failed to remove \${INSTALLED_SUDOERS}"
        info "OK: removed \${INSTALLED_SUDOERS}"
    fi
    if [ -e "\${LEGACY_INSTALLED_SUDOERS}" ] && [ "\${LEGACY_INSTALLED_SUDOERS}" != "\${INSTALLED_SUDOERS}" ]; then
        info "NOTE: legacy shared fragment still present: \${LEGACY_INSTALLED_SUDOERS}"
        info "      This script only removes the per-user path for \${GEN_USER}."
        info "      To remove legacy: sudo rm \${LEGACY_INSTALLED_SUDOERS}"
    fi
    if command -v visudo >/dev/null 2>&1; then
        visudo -c >/dev/null 2>&1 || info "WARN: visudo -c reported issues after remove (check other fragments)"
    fi
    info "Note: does not remove ${APP_NAME} binaries, other users' fragments, or /var/backup archives"
}

cmd_replace() {
    cmd_uninstall
    cmd_install
}

cmd_status() {
    if [ -f "\${INSTALLED_SUDOERS}" ]; then
        info "installed: \${INSTALLED_SUDOERS}"
        ls -la "\${INSTALLED_SUDOERS}" 2>/dev/null || true
    else
        info "installed: (absent) \${INSTALLED_SUDOERS}"
    fi
    if [ -e "\${LEGACY_INSTALLED_SUDOERS}" ] && [ "\${LEGACY_INSTALLED_SUDOERS}" != "\${INSTALLED_SUDOERS}" ]; then
        info "legacy_installed: \${LEGACY_INSTALLED_SUDOERS}"
        ls -la "\${LEGACY_INSTALLED_SUDOERS}" 2>/dev/null || true
    fi
    # Sibling per-user fragments (multi-user host)
    for _sib in /etc/sudoers.d/\${APP_NAME}-*; do
        if [ -e "\${_sib}" ] && [ "\${_sib}" != "\${INSTALLED_SUDOERS}" ]; then
            info "other_user_fragment: \${_sib}"
        fi
    done
    if [ -f "\${PROJECT_SUDOERS_FILE}" ]; then
        info "draft: \${PROJECT_SUDOERS_FILE}"
        ls -la "\${PROJECT_SUDOERS_FILE}" 2>/dev/null || true
    else
        info "draft: (absent) \${PROJECT_SUDOERS_FILE}"
    fi
    info "generated_for_user=\${GEN_USER} trust_tier=\${GEN_TIER}"
}

usage() {
    cat <<U
Usage: sudo sh \$0 {install|uninstall|replace|status}
  install    visudo-check project sudoers file → install -m 0440 → per-user /etc/sudoers.d/
  uninstall  remove /etc/sudoers.d/${APP_NAME}-<user> for this script's user (leave elev)
  replace    uninstall then install (refresh host fragment from draft)
  status     show draft + installed presence (incl. legacy / other users if present)
Project sudoers file: \${PROJECT_SUDOERS_FILE}
Installed path:       \${INSTALLED_SUDOERS}
U
}

_action="\${1:-}"
case "\${_action}" in
    install)   cmd_install ;;
    uninstall) cmd_uninstall ;;
    replace)   cmd_replace ;;
    status)    cmd_status ;;
    -h|--help|help|"") usage; [ -n "\${_action}" ] || exit 1 ;;
    *) die "Unknown action: \${_action}"; usage; exit 1 ;;
esac
exit 0
EOF

    chmod 0750 "${_script_out}" 2>/dev/null || chmod +x "${_script_out}" 2>/dev/null || true

    out_success "Wrote admin sudoers script: ${_script_out}"
    out_info "Project sudoers file (draft): ${_draft}"
    out_info "Installed path (admin only, per-user): ${_installed}"
    out_empty_line
    out_info "Handoff — login as account with sudo, then:"
    out_plain "  sudo sh ${_script_out} install     # install/refresh THIS user's host fragment"
    out_plain "  sudo sh ${_script_out} uninstall   # remove THIS user's host fragment"
    out_plain "  sudo sh ${_script_out} replace     # uninstall then install"
    out_plain "  sudo sh ${_script_out} status"
    if [ "${_tier}" != "production" ]; then
        out_warn "TEST MODE trust_tier=${_tier}: after testing, admin should uninstall fragment soon."
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "print-sudoers-install-script" "written" \
            "script_path" "${_script_out}" \
            "project_sudoers_file" "${_draft}" \
            "installed_path" "${_installed}" \
            "user" "${_user}" \
            "trust_tier" "${_tier}"
    fi
    return 0
}

# =============================================================================
# fb_remove_project_sudoers() - Type 0: remove project-sudoers-file (draft only)
# =============================================================================
#
# GENERAL PURPOSE:
# Delete the product-owned project-sudoers-file draft(s). Default discovery lists
# drafts under ${HOME}/.config/${APP_NAME}/ (legacy sudoers.fragment +
# sudoers.fragment-<user>). When multiple drafts exist and no path arg is given,
# interactive mode lists them and lets the user choose; non-interactive requires
# an explicit path (or --force only when a single draft / current default).
# Never touches /etc/sudoers.d/. Confirm unless --force.
# Probes host installed path(s) and warns when elev is still active (honesty).
#
# ALIGNMENT:
# - term project-sudoers-file
# - requirement-three-layer-privilege-model.md §2.3.3b
#
# Last updated: 2026-09-23
# =============================================================================
fb_remove_project_sudoers() {
    : "${APP_NAME:=folder-backup}"
    : "${HOME:=/tmp}"
    : "${FORCE:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${TTY:=0}"

    _path="${1:-}"
    _installed=$(fb_default_installed_sudoers_path)
    _legacy=$(fb_legacy_installed_sudoers_path)
    _default_draft=$(fb_default_project_sudoers_path)
    _host_present=0
    _host_list=""
    _host_list=$(fb_list_host_sudoers_fragments 2>/dev/null || true)
    if [ -n "${_host_list}" ]; then
        _host_present=1
    fi

    # --- Resolve which draft path to remove ---
    if [ -z "${_path}" ]; then
        _draft_list=$(fb_list_project_sudoers_drafts 2>/dev/null || true)
        _count=0
        if [ -n "${_draft_list}" ]; then
            _count=$(printf '%s\n' "${_draft_list}" | grep -c . 2>/dev/null || echo 0)
        fi
        # normalize count (grep -c may leave trailing newline issues)
        _count=$(printf '%s' "${_count}" | tr -d '[:space:]')
        : "${_count:=0}"

        if [ "${_count}" -eq 0 ]; then
            _path="${_default_draft}"
        elif [ "${_count}" -eq 1 ]; then
            _path=$(printf '%s\n' "${_draft_list}" | head -n 1)
        else
            # Multiple drafts: list and choose (interactive) or fail closed with list
            out_info "Multiple project-sudoers-file drafts found under ${HOME}/.config/${APP_NAME}/:"
            _i=0
            # shellcheck disable=SC2039
            _indexed=""
            while IFS= read -r _line; do
                [ -n "${_line}" ] || continue
                _i=$((_i + 1))
                out_plain "  ${_i}) ${_line}"
                _indexed="${_indexed}${_i}|${_line}
"
            done <<EOF
${_draft_list}
EOF
            out_plain "  0) cancel"
            out_info "Pass an explicit path to remove one non-interactively, e.g.:"
            out_plain "  ${APP_NAME} remove-project-sudoers --force <path>"

            if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY}" -eq 0 ]; then
                out_die "remove-project-sudoers: multiple drafts present; specify path argument (non-interactive)."
            fi

            prompt_ask "Choose draft number to remove" "0"
            _choice="${PROMPT_ASK_VALUE}"
            case "${_choice}" in
                ''|0|[Cc][Aa][Nn][Cc][Ee][Ll]*)
                    out_info "Remove cancelled"
                    return 0
                    ;;
                *[!0-9]*)
                    out_die "Invalid choice: ${_choice}"
                    ;;
            esac
            if [ "${_choice}" -lt 1 ] || [ "${_choice}" -gt "${_i}" ]; then
                out_die "Choice out of range: ${_choice} (1-${_i}, or 0 to cancel)"
            fi
            _path=$(printf '%s\n' "${_indexed}" | while IFS='|' read -r _n _p; do
                if [ "${_n}" = "${_choice}" ]; then
                    printf '%s' "${_p}"
                    break
                fi
            done)
            if [ -z "${_path}" ]; then
                out_die "Could not resolve choice ${_choice}"
            fi
        fi
    fi

    # Refuse removing under /etc as Type 0 (host elev is admin-only)
    case "${_path}" in
        /etc/*|/etc)
            out_die "Refusing to remove paths under /etc as Type 0. This command only deletes the user draft (project-sudoers-file). Host elev is admin-only: sudo rm ${_installed}  OR  ${APP_NAME} print-sudoers-install-script && sudo sh <script> uninstall"
            ;;
    esac

    _status=""
    if [ ! -e "${_path}" ]; then
        _status="already_absent"
        out_success "Project sudoers draft not present (nothing to remove): ${_path}"
    else
        if [ "${FORCE}" -eq 0 ]; then
            if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY}" -eq 0 ]; then
                out_die "remove-project-sudoers requires confirmation. Re-run with --force in non-interactive mode."
            fi
            if ! prompt_yes_no "Remove project-sudoers-file draft ${_path}?"; then
                out_info "Remove cancelled"
                return 0
            fi
        fi
        if ! rm -f "${_path}"; then
            out_die "Failed to remove ${_path}"
        fi
        _status="removed"
        out_success "Removed project-sudoers-file draft: ${_path}"
    fi

    # Honesty: draft and host elev are two layers (L-SUDOERS-03). Multi-user: list all present.
    if [ "${JSON}" -eq 0 ]; then
        if [ "${_host_present}" -eq 1 ]; then
            out_warn "Host elevation STILL ACTIVE (separate from draft):"
            printf '%s\n' "${_host_list}" | while IFS= read -r _hp; do
                [ -n "${_hp}" ] || continue
                out_plain "  ${_hp}"
            done
            out_info "remove-project-sudoers only deletes the user draft — never /etc/sudoers.d/."
            out_info "Admin leave elev (this user): sudo rm ${_installed}"
            if [ -e "${_legacy}" ] && [ "${_legacy}" != "${_installed}" ]; then
                out_info "Admin leave elev (legacy shared): sudo rm ${_legacy}"
            fi
            out_info "Or handoff script: ${APP_NAME} print-sudoers-install-script && sudo sh <script> uninstall"
        else
            out_info "Host fragment also absent (no elev at ${_installed}; no legacy ${_legacy})."
        fi
    else
        if [ "${_status}" = "removed" ]; then
            out_json "remove-project-sudoers" "removed" \
                "path" "${_path}" \
                "status" "removed" \
                "installed_path" "${_installed}" \
                "host_fragment_present" "${_host_present}" \
                "note" "does not remove /etc/sudoers.d fragment"
        else
            out_json "remove-project-sudoers" "already absent" \
                "path" "${_path}" \
                "status" "already_absent" \
                "installed_path" "${_installed}" \
                "host_fragment_present" "${_host_present}"
        fi
    fi
    return 0
}

# app_menu_draw_on() / app_menu_draw_off() - Ink while a board is showing
# =============================================================================
#
# Drawing ignores --json and --quiet so the numbered list stays human.
# A leaf restores the saved flags before it runs.
# =============================================================================
app_menu_draw_on() {
    : "${_menu_json:=0}"
    : "${_menu_quiet:=0}"
    JSON=0
    QUIET=0
    export JSON QUIET
}

app_menu_draw_off() {
    : "${_menu_json:=0}"
    : "${_menu_quiet:=0}"
    JSON="${_menu_json}"
    QUIET="${_menu_quiet}"
    export JSON QUIET
}

# =============================================================================
# app_menu_run_leaf() - Run one numbered-board leaf by verb token
# =============================================================================
#
# Returns 0 after a listed leaf (including Next: when a required field is
# empty). Returns 1 when the token is not a leaf. Callers map numbers.
# A finished leaf redisplays the front board. Test-purpose verbs are not
# leaves. Local uninstall and where-is-me stay typed commands.
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
# =============================================================================
app_menu_run_leaf() {
    _leaf="${1-}"
    _a="${2-}"
    _b="${3-}"
    : "${APP_NAME:=folder-backup}"

    case "${_leaf}" in
        backup)
            if [ -z "${_a}" ]; then
                prompt_line "Folder to pack" || true
                _a="${_prompt_line}"
            fi
            if [ -z "${_a}" ]; then
                out_info "Next: ${APP_NAME} backup <source-folder>"
                unset _leaf _a _b
                return 0
            fi
            fb_backup "${_a}"
            ;;
        restore)
            if [ -z "${_a}" ]; then
                prompt_line "Archive or prefix" || true
                _a="${_prompt_line}"
            fi
            if [ -z "${_a}" ]; then
                out_info "Next: ${APP_NAME} restore <archive|prefix> [dest]"
                unset _leaf _a _b
                return 0
            fi
            fb_restore "${_a}" "${_b}"
            ;;
        submit-sudoer-request)
            fb_submit_sudoer_request "${_a}"
            ;;
        remove-project-sudoers)
            fb_remove_project_sudoers "${_a}"
            ;;
        install)
            inst_local_install
            ;;
        version)
            # On a numbered board, version is the about diagnostics.
            # Argv version stays app_version in the dispatcher.
            app_about
            ;;
        about)
            app_about
            ;;
        version-check)
            ver_check
            ;;
        self-update)
            inst_self_update
            ;;
        self-uninstall)
            inst_self_uninstall
            ;;
        self-install)
            inst_self_install
            ;;
        *)
            unset _leaf _a _b
            return 1
            ;;
    esac
    unset _leaf _a _b
    return 0
}

# =============================================================================
# app_lang_load() - One language code for this process
# =============================================================================
#
# APP_LANG is en, zh-Hant, es, fr, de, zh-Hans, ja, or ko.
# A missing file, an empty file, or any other first line stays en.
# FOLDER_BACKUP_LANG wins over the file when it is one of those codes.
# Call once at the start of app_main, after persistence is resolved.
# A later pick sets APP_LANG in this process. Do not call this again
# in that process, or the env value would cover the pick.
#
# ALIGNMENT:
# - requirement-shell-cli-language.md
# - requirement-shell-cli-storage.md
# =============================================================================
app_lang_load() {
    APP_LANG=en
    if [ -z "${PERSISTENT_STORAGE_DIR:-}" ]; then
        PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
        export PERSISTENT_STORAGE_DIR
    fi
    _ll_path="${PERSISTENT_STORAGE_DIR}/language"
    if [ -f "${_ll_path}" ]; then
        _ll_line=$(head -n 1 "${_ll_path}" 2>/dev/null || true)
        _ll_line=$(printf '%s' "${_ll_line}" | tr -d '\r')
        case "${_ll_line}" in
            en|zh-Hant|es|fr|de|zh-Hans|ja|ko) APP_LANG="${_ll_line}" ;;
        esac
    fi
    case "${FOLDER_BACKUP_LANG-}" in
        en|zh-Hant|es|fr|de|zh-Hans|ja|ko) APP_LANG="${FOLDER_BACKUP_LANG}" ;;
    esac
    export APP_LANG
    unset _ll_path _ll_line
}

# =============================================================================
# app_lang_save() - Write the language leaf and set APP_LANG
# =============================================================================
#
# One line, mode 0600, under persistence. APP_LANG changes only after
# the write succeeds. A code outside the eight returns failure.
#
# ALIGNMENT:
# - requirement-shell-cli-language.md
# - requirement-shell-cli-storage.md
# =============================================================================
app_lang_save() {
    _ls_code=${1-}
    case "${_ls_code}" in
        en|zh-Hant|es|fr|de|zh-Hans|ja|ko) ;;
        *)
            unset _ls_code
            return 1
            ;;
    esac
    if [ -z "${PERSISTENT_STORAGE_DIR:-}" ]; then
        PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
        export PERSISTENT_STORAGE_DIR
    fi
    _ls_path="${PERSISTENT_STORAGE_DIR}/language"
    if ! printf '%s\n' "${_ls_code}" > "${_ls_path}"; then
        unset _ls_code _ls_path
        return 1
    fi
    chmod 0600 "${_ls_path}" 2>/dev/null || true
    APP_LANG="${_ls_code}"
    export APP_LANG
    unset _ls_code _ls_path
    return 0
}

