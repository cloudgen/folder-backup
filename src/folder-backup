# =============================================================================
# util_get_current_shell() - Detect current / parent shell name
# =============================================================================
#
# GENERAL PURPOSE:
# Returns a best-effort shell command name for diagnostics (about).
# Prefer parent shell when the current process is sh/dash/ash/the app itself.
#
# PRINTF EXCEPTION (class B – function return-via-stdout):
# Final printf '%s' "$shell" (and echo fallbacks inside $(…)) are data
# returns for capture by app_about — not product messages. Display uses out_*.
# See requirement-shell-output-requirements.md §2.1.1.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# Nested functions are not portable POSIX; this must stay top-level.
#
# Last reviewed: 2026-07-12
# =============================================================================
util_get_current_shell() {
    local shell="unknown"
    shell=$(ps -p $$ -o comm= 2>/dev/null | tr -d '()' || echo "unknown")

    if [ "$shell" = "${APP_NAME}" ] || [ "$shell" = "sh" ] || \
       [ "$shell" = "dash" ] || [ "$shell" = "ash" ]; then
        local parent_pid
        parent_pid=$(ps -p $$ -o ppid= 2>/dev/null | tr -d ' ')
        if [ -n "$parent_pid" ]; then
            shell=$(ps -p "$parent_pid" -o comm= 2>/dev/null | tr -d '()' || echo "$shell")
        fi
    fi
    printf '%s' "$shell"
}


# =============================================================================
# app_about() - Diagnostics (selfmanaged channel + folder-backup domain)
# =============================================================================
#
# ALIGNMENT:
# - requirement-shell-cli-interface.md
# - requirement-domain-folder-backup.md (about domain fields)
# - requirement-shell-cli-storage.md
#
# Last updated: 2026-09-23
# =============================================================================
app_about() {
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=folder-backup}"
    : "${VERSION:=1.22.0}"
    : "${REPO_USER:=cloudgen}"
    : "${REPO_NAME:=folder-backup}"
    : "${SCRIPT_URL:=}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${HOME:=/tmp}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${USERNAME:=unknown}"
    : "${RESTORE_HOST_DEFAULT:=hard-disk}"
    : "${PROJECTS_ROOT:=}"
    : "${RAM_ROOT:=/dev/shm}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"
    : "${BACKUP_ROOT:=/var/backup}"
    : "${BACKUP_NOTATION:=folder-backup}"
    : "${MAX_DAILY_BACKUPS:=5}"
    : "${MAX_TOTAL_BACKUPS:=30}"

    if [ -z "${EFFECTIVE_STORAGE_DIR:-}" ]; then
        EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    fi
    _cache_pref=$(util_preferred_cache_dir)
    _cache_fb=$(util_fallback_cache_dir)
    _cache_fb2=$(util_fallback2_cache_dir)
    STORAGE_DIR="${_cache_fb}"
    if [ -z "${PERSISTENT_STORAGE_DIR:-}" ]; then
        PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
    fi

    _installed="false"
    inst_is_installed && _installed="true"

    _global_ver="not found"
    if [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
        _global_ver=$(grep '^VERSION="' "${GLOBAL_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
    fi
    _local_ver="not found"
    if [ -x "${USER_BIN}/${APP_NAME}" ]; then
        _local_ver=$(grep '^VERSION="' "${USER_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
    fi
    _shell=$(util_get_current_shell)
    _user=$(id -un 2>/dev/null || echo "unknown")
    _interactive="false"
    [ "${TTY:-0}" -eq 1 ] && _interactive="true"

    # Best-effort sudo deposit probe
    _sudo_deposit="unknown"
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        _sudo_deposit="root"
    elif command -v sudo >/dev/null 2>&1; then
        if sudo -n true 2>/dev/null; then
            _sudo_deposit="sudo_n_ok"
        else
            _sudo_deposit="sudo_needs_auth_or_denied"
        fi
    else
        _sudo_deposit="no_sudo"
    fi

    _sudoer_cli="not_found"
    if _scli_path=$(fb_detect_sudoer_cli); then
        _sudoer_cli="${_scli_path}"
    fi
    _sudoer_adm="absent"
    if _sadm_name=$(fb_detect_sudoer_adm); then
        _sudoer_adm="${_sadm_name}"
    fi
    _sudoer_inbound="not_found"
    _sudoer_inbound_writable="false"
    if _sin_path=$(fb_detect_sudoer_inbound); then
        _sudoer_inbound="${_sin_path}"
        if [ -w "${_sin_path}" ]; then
            _sudoer_inbound_writable="true"
        fi
    fi

    _host_sudoers_present="false"
    _host_sudoers_path=""
    if _hsp=$(fb_probe_current_user_host_sudoers); then
        _host_sudoers_present="true"
        _host_sudoers_path="${_hsp}"
    fi

    if [ "${JSON}" -eq 1 ]; then
        out_json "about" "" \
            "app" "${APP_NAME}" \
            "version" "${VERSION}" \
            "repo_user" "${REPO_USER}" \
            "repo_name" "${REPO_NAME}" \
            "repository" "${REPO_USER}/${REPO_NAME}" \
            "script_url" "${SCRIPT_URL}" \
            "installed" "${_installed}" \
            "global_version" "${_global_ver}" \
            "local_version" "${_local_ver}" \
            "shell" "${_shell}" \
            "interactive" "${_interactive}" \
            "user" "${_user}" \
            "cache_used" "${EFFECTIVE_STORAGE_DIR}" \
            "cache_preferred" "${_cache_pref}" \
            "cache_fallback" "${_cache_fb}" \
            "cache_fallback_2" "${_cache_fb2}" \
            "persistence_storage" "${PERSISTENT_STORAGE_DIR}" \
            "effective_storage" "${EFFECTIVE_STORAGE_DIR}" \
            "storage_dir" "${STORAGE_DIR}" \
            "backup_root" "${BACKUP_ROOT}" \
            "backup_notation" "${BACKUP_NOTATION}" \
            "deposit_dir" "${BACKUP_ROOT}/${BACKUP_NOTATION}" \
            "sudo_deposit" "${_sudo_deposit}" \
            "sudoers_trust_tier" "$(fb_sudoers_trust_tier)" \
            "sudoer_cli" "${_sudoer_cli}" \
            "sudoer_adm" "${_sudoer_adm}" \
            "sudoer_inbound" "${_sudoer_inbound}" \
            "sudoer_inbound_writable" "${_sudoer_inbound_writable}" \
            "host_sudoers_present" "${_host_sudoers_present}" \
            "host_sudoers_path" "${_host_sudoers_path}" \
            "max_daily_backups" "$(fb_positive_int_or_default "${MAX_DAILY_BACKUPS}" 5)" \
            "max_total_backups" "$(fb_positive_int_or_default "${MAX_TOTAL_BACKUPS}" 30)" \
            "restore_host_default" "${RESTORE_HOST_DEFAULT}" \
            "projects_root" "$(util_resolve_projects_root 2>/dev/null || echo "")" \
            "ram_root" "${RAM_ROOT}"
        return 0
    fi

    [ "${QUIET}" -eq 1 ] && return 0

    out_info "$(util_app_ident) — $(app_menu_text about_title)"
    out_empty_line
    if [ "${_installed}" = "true" ]; then
        out_success "${APP_NAME} is properly installed."
    else
        out_warn "${APP_NAME} is NOT installed in a managed bin path."
        out_info "   Recommended: ${APP_NAME} install   (local copy → ${USER_BIN}/${APP_NAME})"
    fi
    out_empty_line
    out_info "Global install  (${GLOBAL_BIN}/${APP_NAME}):   ${_global_ver}"
    out_info "Local install   (${USER_BIN}/${APP_NAME}):    ${_local_ver}"
    _tier=$(fb_sudoers_trust_tier)
    out_info "Sudoers trust tier: ${_tier}  (production requires global; local-only = test mode)"
    out_empty_line
    out_info "Repository:        ${REPO_USER}/${REPO_NAME}"
    if [ -n "${SCRIPT_URL}" ]; then
        out_info "Install channel:   ${SCRIPT_URL}"
    else
        out_info "Install channel:   (empty — local install only)"
    fi
    out_empty_line
    out_info "Current user:      ${_user}"
    if [ "$(id -u)" -eq 0 ]; then
        out_success "Execution context: root"
    else
        out_info "Execution context: normal user (Type 0 + narrow Type 1 deposit)"
    fi
    out_empty_line
    out_info "Current shell:     ${_shell}"
    if [ "${TTY:-0}" -eq 1 ]; then
        out_info "TTY / Interactive: yes"
    else
        out_info "TTY / Interactive: no"
    fi
    out_empty_line
    out_info "$(app_menu_text cache_used_label)${EFFECTIVE_STORAGE_DIR}"
    out_info "Cache folder (preferred): ${_cache_pref}"
    out_info "Cache folder (1st fallback): ${_cache_fb}"
    if [ -n "${_cache_fb2}" ]; then
        out_info "Cache folder (2nd fallback): ${_cache_fb2}"
    fi
    out_info "Persistence storage:      ${PERSISTENT_STORAGE_DIR}"
    out_empty_line
    out_info "Backup root:       ${BACKUP_ROOT}"
    out_info "Backup notation:   ${BACKUP_NOTATION}"
    out_info "Deposit directory: ${BACKUP_ROOT}/${BACKUP_NOTATION}"
    out_info "Sudo deposit:      ${_sudo_deposit}"
    out_info "sudoer-cli:        ${_sudoer_cli}"
    out_info "sudoer-adm:        ${_sudoer_adm}"
    if [ "${_sudoer_inbound}" = "not_found" ]; then
        out_info "sudoer inbound:    not_found (preferred ${SUDOER_PUBLIC_ROOT:-/var/sudoer-cli}/sudoer-request)"
    else
        out_info "sudoer inbound:    ${_sudoer_inbound} (writable=${_sudoer_inbound_writable})"
    fi
    out_info "Retention daily:   max $(fb_positive_int_or_default "${MAX_DAILY_BACKUPS}" 5) per basename per day (MAX_DAILY_BACKUPS)"
    out_info "Retention total:   max $(fb_positive_int_or_default "${MAX_TOTAL_BACKUPS}" 30) per basename (MAX_TOTAL_BACKUPS)"
    _proot=$(util_resolve_projects_root 2>/dev/null || echo "")
    out_info "Restore default host: ${RESTORE_HOST_DEFAULT} (reverse of ram-drive-first)"
    out_info "Projects root (hard-disk): ${_proot:-unset — set PROJECTS_ROOT}"
    out_info "RAM root:          ${RAM_ROOT}"
    out_empty_line
    out_info "Useful commands:"
    out_info "   ${APP_NAME} help            → Full usage"
    out_info "   ${APP_NAME} install         → Local install to ~/.local/bin"
    out_info "   ${APP_NAME} print-sudoers   → Sudoers fragment for admin"
    out_info "   ${APP_NAME} generate-sudoer-request → Write a local JSON grant you can verify"
    out_info "   ${APP_NAME} submit-sudoer-request → JSON request into /var/sudoer-cli/sudoer-request"
    out_info "   ${APP_NAME} backup <dir>    → Archive + deposit + retention prune"
    out_info "   ${APP_NAME} restore <name>  → Restore archive (default dest: hard-disk)"
    out_info "   ${APP_NAME} --json          → Machine-readable output"
}

app_version() {
    : "${APP_NAME:=folder-backup}"
    : "${VERSION:=1.22.0}"
    : "${JSON:=0}"
    if [ "${JSON}" -eq 1 ]; then
        # Same machine contract as historical app_main inline path
        out_json "version" "" "app" "${APP_NAME}" "version" "${VERSION}"
    else
        out_info "${APP_NAME} version ${VERSION}"
    fi
}

# =============================================================================
# util_resolve_running_path() - Absolute path of running ship unit (class B)
# =============================================================================
#
# GENERAL PURPOSE:
# Resolve the absolute path of the currently executing ship unit for local
# install source. Returns empty string when $0 is not a resolvable file
# (e.g. stdin pipe degradation).
#
# PRINTF EXCEPTION (class B): path data for $(…) capture only.
#
# ALIGNMENT:
# - requirement-shell-local-self-management.md
#
# Last reviewed: 2026-08-03
# =============================================================================
util_resolve_running_path() {
    : "${0:=}"
    _src="$0"
    _resolved=""

    case "$_src" in
        ""|sh|bash|dash|ash|zsh|ksh|*/sh|*/bash|*/dash|*/ash|*/zsh|*/ksh)
            if [ ! -f "$_src" ]; then
                printf '%s' ""
                return 0
            fi
            ;;
    esac

    if [ ! -f "$_src" ] && [ ! -L "$_src" ]; then
        printf '%s' ""
        return 0
    fi

    if command -v readlink >/dev/null 2>&1; then
        _resolved=$(readlink -f "$_src" 2>/dev/null || true)
        if [ -n "$_resolved" ] && [ -e "$_resolved" ]; then
            printf '%s' "$_resolved"
            return 0
        fi
    fi
    if command -v realpath >/dev/null 2>&1; then
        _resolved=$(realpath "$_src" 2>/dev/null || true)
        if [ -n "$_resolved" ] && [ -e "$_resolved" ]; then
            printf '%s' "$_resolved"
            return 0
        fi
    fi

    # Fallback: dirname/basename join
    _dir=$(CDPATH= cd -- "$(dirname -- "$_src")" 2>/dev/null && pwd)
    _base=$(basename -- "$_src")
    if [ -n "$_dir" ] && [ -f "${_dir}/${_base}" ]; then
        printf '%s' "${_dir}/${_base}"
        return 0
    fi
    printf '%s' ""
}

# =============================================================================
# inst_local_install() - Local copy install (no network)
# =============================================================================
#
# GENERAL PURPOSE:
# Copy the running ship unit to the privilege-correct bin path.
# Root → GLOBAL_BIN; non-root → USER_BIN. Idempotent unless FORCE/FORCE_REINSTALL.
#
# ALIGNMENT:
# - requirement-shell-local-self-management.md
# - requirement-shell-idempotency.md
#
# Mode SSOT for managed binary (shell ship unit needs world-read for non-owners).
# Do NOT use chmod +x alone after mktemp (0600|0111 → 0711 breaks multi-user exec).
INST_MANAGED_MODE="0755"

# Last reviewed: 2026-08-09 — mode 0755 multi-user (requirement-shell-local-self-management §2.3.1)
# =============================================================================
inst_local_install() {
    : "${APP_NAME:=folder-backup}"
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"
    : "${FORCE_GLOBAL:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${INST_MANAGED_MODE:=0755}"

    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        IS_ROOT=1
    else
        IS_ROOT=0
    fi
    : "${IS_ROOT:=0}"

    # Root or --global / FORCE_GLOBAL → system-wide path (production elevation story).
    if [ "${FORCE_GLOBAL}" -eq 1 ] || [ "${IS_ROOT}" -eq 1 ]; then
        _target_dir="${GLOBAL_BIN}"
    else
        _target_dir="${USER_BIN}"
    fi
    _target="${_target_dir}/${APP_NAME}"
    INSTALL_PATH="${_target}"

    if [ -x "${_target}" ] || [ -f "${_target}" ]; then
        if [ "${FORCE}" -eq 0 ] && [ "${FORCE_REINSTALL}" -eq 0 ]; then
            # Mode heal: prior chmod +x after mktemp left 0711/0700; keep multi-user runnable.
            chmod "${INST_MANAGED_MODE}" "${_target}" 2>/dev/null || true
            out_success "${APP_NAME} already installed at ${_target}"
            if [ "${_target_dir}" = "${USER_BIN}" ] && [ "${JSON}" -eq 0 ]; then
                out_warn "Local install is fine for Type 0 use. For durable sudoers, prefer: sudo ${APP_NAME} install  (global ${GLOBAL_BIN})"
            fi
            if [ "${JSON}" -eq 1 ]; then
                out_json "install" "already installed" \
                    "app" "${APP_NAME}" \
                    "path" "${_target}" \
                    "status" "already_installed" \
                    "mode" "${INST_MANAGED_MODE}"
            fi
            return 0
        fi
    fi

    _src=$(util_resolve_running_path)
    if [ -z "${_src}" ] || [ ! -f "${_src}" ]; then
        out_die "Cannot resolve running ship unit path for local install (not a file path)."
    fi

    if [ ! -d "${_target_dir}" ]; then
        if ! mkdir -p "${_target_dir}" 2>/dev/null; then
            if [ "${_target_dir}" = "${GLOBAL_BIN}" ]; then
                out_die "Cannot create ${GLOBAL_BIN} (need root). Run: sudo ${APP_NAME} install   or: sudo sh <ship-unit> install"
            fi
            out_die "Cannot create install directory ${_target_dir}"
        fi
    fi

    if [ ! -w "${_target_dir}" ] 2>/dev/null; then
        if [ "${_target_dir}" = "${GLOBAL_BIN}" ]; then
            out_die "Cannot write ${GLOBAL_BIN} (need root). Run: sudo ${APP_NAME} install   or: sudo sh <ship-unit> install --global"
        fi
        out_die "Install directory not writable: ${_target_dir}"
    fi

    _stage=$(mktemp "${EFFECTIVE_STORAGE_DIR:-/tmp}/${APP_NAME}.install.XXXXXX" 2>/dev/null || mktemp)
    if ! cp "${_src}" "${_stage}"; then
        rm -f "${_stage}" 2>/dev/null || true
        out_die "Failed to stage ship unit for install"
    fi
    # Absolute 0755 required: shell scripts need group/other *read* for non-owner exec.
    # chmod +x on a mktemp file (often 0600) yields 0711 — look executable, fail for others.
    if ! chmod "${INST_MANAGED_MODE}" "${_stage}"; then
        rm -f "${_stage}" 2>/dev/null || true
        out_die "Failed to chmod ${INST_MANAGED_MODE} staged ship unit"
    fi
    if ! mv -f "${_stage}" "${_target}"; then
        rm -f "${_stage}" 2>/dev/null || true
        out_die "Failed to install to ${_target}"
    fi
    # Re-assert mode after mv (some filesystems / policies may alter bits).
    if ! chmod "${INST_MANAGED_MODE}" "${_target}"; then
        out_die "Installed ${_target} but failed to set mode ${INST_MANAGED_MODE}"
    fi
    if [ ! -r "${_target}" ] || [ ! -x "${_target}" ]; then
        out_die "Installed ${_target} is not readable+executable (mode heal failed)"
    fi

    out_success "Installed ${APP_NAME} to ${_target}"
    if [ "${_target_dir}" = "${USER_BIN}" ]; then
        # Best-effort PATH integration for user bin (function, not external)
        path_add_shell 2>/dev/null || true
        if [ "${JSON}" -eq 0 ]; then
            out_warn "Local install is user-rewritable. Durable sudoers should use global install (root → ${GLOBAL_BIN})."
        fi
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "install" "installed" \
            "app" "${APP_NAME}" \
            "path" "${_target}" \
            "status" "installed" \
            "mode" "${INST_MANAGED_MODE}"
    fi
    return 0
}

# =============================================================================
# inst_local_uninstall() - Local remove managed binary only
# =============================================================================
#
# GENERAL PURPOSE:
# Remove the managed binary at the privilege-correct path. Confirm when
# interactive unless --force. Non-interactive without force fails closed.
# Does NOT delete /var/backup archives or user data.
#
# ALIGNMENT:
# - requirement-shell-local-self-management.md
# - requirement-shell-interactive-vs-noninteractive.md
#
# Last reviewed: 2026-08-03
# =============================================================================
inst_local_uninstall() {
    : "${APP_NAME:=folder-backup}"
    : "${HOME:=/tmp}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${FORCE:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${TTY:=0}"

    _target=$(util_get_install_bin_path)

    if [ ! -e "${_target}" ]; then
        out_success "${APP_NAME} is not installed (nothing to uninstall)"
        if [ "${JSON}" -eq 1 ]; then
            out_json "uninstall" "already absent" \
                "app" "${APP_NAME}" \
                "path" "${_target}" \
                "status" "already_uninstalled"
        fi
        return 0
    fi

    if [ "${FORCE}" -eq 0 ]; then
        if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY}" -eq 0 ]; then
            out_die "Uninstall requires confirmation. Re-run with --force in non-interactive mode."
        fi
        if ! prompt_yes_no "Remove managed binary ${_target}?"; then
            out_info "Uninstall cancelled"
            return 0
        fi
    fi

    if ! rm -f "${_target}"; then
        out_die "Failed to remove ${_target}"
    fi
    out_success "Removed ${APP_NAME} from ${_target}"
    _installed=$(fb_default_installed_sudoers_path)
    if [ "${JSON}" -eq 0 ]; then
        out_warn "Uninstall does not remove host sudoers fragments under /etc/sudoers.d/."
        out_info "If elevation was test-mode only, admin should uninstall soon: sudo rm ${_installed}"
        out_info "Multi-user: other users keep their own /etc/sudoers.d/${APP_NAME}-<user> fragments."
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "uninstall" "removed" \
            "app" "${APP_NAME}" \
            "path" "${_target}" \
            "status" "uninstalled" \
            "sudoers_note" "does not remove /etc/sudoers.d/${APP_NAME}-<user>"
    fi
    return 0
}

# =============================================================================
# app_where_is_me() - Report running + install paths
# =============================================================================
#
# ALIGNMENT:
# - requirement-shell-local-self-management.md
#
# Last reviewed: 2026-08-03
# =============================================================================
app_where_is_me() {
    : "${APP_NAME:=folder-backup}"
    : "${JSON:=0}"
    : "${QUIET:=0}"

    _running=$(util_resolve_running_path)
    _install=$(util_get_install_bin_path)
    _installed="false"
    if [ -x "${_install}" ]; then
        _installed="true"
    fi

    if [ "${JSON}" -eq 1 ]; then
        out_json "where-is-me" "" \
            "app" "${APP_NAME}" \
            "running_path" "${_running:-}" \
            "install_path" "${_install}" \
            "installed" "${_installed}"
        return 0
    fi

    if [ -n "${_running}" ]; then
        out_info "Running path:  ${_running}"
    else
        out_warn "Running path:  (unresolvable — not a file path / pipe?)"
    fi
    out_info "Install path:  ${_install}"
    if [ "${_installed}" = "true" ]; then
        out_success "Installed:     yes"
    else
        out_info "Installed:     no"
    fi
}

