#
# ALIGNMENT (live requirements only):
# - requirement-shell-cli-interface.md
#
# Last updated: 2026-09-17
# =============================================================================
inst_self_install_copy_from_script() {
    local _src="$1"
    local _mode="$2"
    local _tmp
    : "${APP_NAME:=folder-backup}"
    : "${JSON:=0}"
    : "${INSTALL_PATH:=}"

    _tmp=$(util_mktemp "stage")
    if [ -z "${_tmp}" ]; then
        if [ "${JSON}" -eq 1 ]; then
