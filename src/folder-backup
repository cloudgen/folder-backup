# =============================================================================
# util_cache_try_dir() - create one cache tier; silent on failure
# =============================================================================
#
# GENERAL PURPOSE:
# Create the parent, then the leaf mode 0700. Return 0 when the leaf exists
# and is writable. Return 1 with no message when it does not. The caller
# tries the next tier. A skipped tier is not a warning and not an error.
#
# ALIGNMENT: requirement-shell-cli-storage.md
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
#
# Last updated: 2026-09-27
# =============================================================================
util_cache_try_dir() {
    _cdir="${1:-}"
    if [ -z "${_cdir}" ]; then
        unset _cdir
        return 1
    fi
    _cparent=$(dirname "${_cdir}")
    case "${_cparent}" in
        /dev/shm/cache|/tmp/cache)
            if ! mkdir -m 1777 -p "${_cparent}" 2>/dev/null; then
                if ! mkdir -p "${_cparent}" 2>/dev/null; then
                    unset _cdir _cparent
                    return 1
                fi
            fi
            ;;
        *)
            if ! mkdir -p "${_cparent}" 2>/dev/null; then
                unset _cdir _cparent
                return 1
            fi
            ;;
    esac
    if ! mkdir -m 0700 -p "${_cdir}" 2>/dev/null; then
        if ! mkdir -p "${_cdir}" 2>/dev/null; then
            unset _cdir _cparent
            return 1
        fi
    fi
    if [ ! -d "${_cdir}" ] || [ ! -w "${_cdir}" ]; then
        unset _cdir _cparent
        return 1
    fi
    unset _cdir _cparent
    return 0
}

