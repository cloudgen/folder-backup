        out_menu_choice 8 "$(app_menu_text cat_self)" "$(app_menu_text front_self_long)"
        out_menu_choice 9 "$(app_menu_text word_exit)"
        if [ -n "${_argv_pick}" ]; then
            _pick="${_argv_pick}"
            _argv_pick=""
        else
            out_msg_n "$(app_menu_text line_prompt)"
            if ! read -r _prompt_line; then
                app_menu_draw_off
                unset _pick _argv_pick _argv_a _argv_b _menu_json _menu_quiet
                return 0
            fi
            _pick="${_prompt_line}"
        fi
        case "${_pick}" in
            9|99|exit|quit|Exit|QUIT|""|q|Q|離開|离开|Salir|Quitter|Beenden|終了|종료)
                app_menu_draw_off
                unset _pick _argv_pick _argv_a _argv_b _menu_json _menu_quiet
                return 0
                ;;
            1|client-side|用戶端|客户端|cliente|client|Client|クライアント|클라이언트)
                app_cmd_menu_client "${_argv_a}" "${_argv_b}"
                _argv_a=""
                _argv_b=""
                continue
                ;;
            6|language|語言|语言|idioma|langue|Sprache|sprache|言語|언어)
                app_cmd_menu_language
                _argv_a=""
                _argv_b=""
                continue
                ;;
            7|sudoers)
                app_cmd_menu_sudoers "${_argv_a}"
                _argv_a=""
                _argv_b=""
                continue
                ;;
            8|self-management|自我管理|autogestión|autogestion|Selbstverwaltung|selbstverwaltung|自己管理|자기관리)
                app_cmd_menu_self
                _argv_a=""
                _argv_b=""
                continue
                ;;
        esac
        app_menu_draw_off
        if app_menu_run_leaf "${_pick}" "${_argv_a}" "${_argv_b}"; then
            _argv_a=""
            _argv_b=""
            continue
        fi
        app_menu_draw_on
        out_error "$(app_menu_text unknown_front "${_pick}")"
        _argv_a=""
        _argv_b=""
    done
}

