# =============================================================================
# app_main() - Main entrypoint and command dispatcher
# =============================================================================
#
# GENERAL PURPOSE:
# Single dispatcher. Architecture and self-management verbs come from
# selfmanaged. Folder-backup verbs and the numbered boards are added here.
# Zero-cli-verb: interactive → numbered boards; non-interactive → self-install.
# Local install is the verb install, not this path.
#
# ALIGNMENT:
# - requirement-bootstrap-chain.md
# - requirement-shell-cli-interface.md
# - requirement-shell-cli-default-interaction.md
# - requirement-shell-cli-zero-arguments.md
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# =============================================================================
app_main() {
    COMMAND=""
    : "${QUIET:=0}"
    : "${JSON:=0}"
    : "${DEBUG:=0}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"
    : "${FORCE_GLOBAL:=0}"
    : "${ALLOW_TEST_LOCAL_SUDOERS:=0}"
    : "${SUBMIT_PURPOSE:=}"
    : "${SUBMIT_ACTION:=add}"
    : "${SUBMIT_ACTION_EXPLICIT:=0}"
    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"
    : "${APP_NAME:=folder-backup}"

    EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
    STORAGE_DIR=$(util_fallback_cache_dir)
    export EFFECTIVE_STORAGE_DIR STORAGE_DIR PERSISTENT_STORAGE_DIR
    export TMPDIR="${EFFECTIVE_STORAGE_DIR}"

    # One language for this process. Do not call again after a menu pick.
    app_lang_load

    # Zero-cli-verb (no tokens). Interactive → numbered boards.
    # Non-interactive → CLI self-install (not help, not local install).
    # requirement-shell-cli-zero-arguments.md
    if [ $# -eq 0 ]; then
        if [ "${TTY}" -eq 1 ] && [ "${JSON}" -eq 0 ] && [ "${QUIET}" -eq 0 ]; then
            app_cmd_menu
            return $?
        fi
        inst_self_install
        return $?
    fi

    _domain_arg=""
    _domain_arg2=""
    _menu_pick=""
    : "${RESTORE_HOST:=}"
    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) QUIET=1 ;;
            --json)     JSON=1; QUIET=1 ;;
            --debug)    DEBUG=1 ;;
            --force)    FORCE=1; FORCE_REINSTALL=1 ;;
            --global)   FORCE_GLOBAL=1; export FORCE_GLOBAL ;;
            --allow-test-local)
                ALLOW_TEST_LOCAL_SUDOERS=1
                export ALLOW_TEST_LOCAL_SUDOERS
                ;;
            --purpose)
                if [ $# -lt 2 ]; then
                    out_die "--purpose requires TEXT"
                fi
                SUBMIT_PURPOSE="$2"
                export SUBMIT_PURPOSE
                shift
                ;;
            --update)
                SUBMIT_ACTION="update"
                SUBMIT_ACTION_EXPLICIT=1
                export SUBMIT_ACTION SUBMIT_ACTION_EXPLICIT
                ;;
            --add)
                SUBMIT_ACTION="add"
                SUBMIT_ACTION_EXPLICIT=1
                export SUBMIT_ACTION SUBMIT_ACTION_EXPLICIT
                ;;
            --disk|--hard-disk)
                RESTORE_HOST="hard-disk"
                export RESTORE_HOST
                ;;
            --ram|--ram-drive)
                RESTORE_HOST="ram-drive"
                export RESTORE_HOST
                ;;
            version|about|help|install|uninstall|where-is-me|backup|restore|print-sudoers|print-sudoers-install-script|remove-project-sudoers|generate-sudoer-request|submit-sudoer-request|menu|main|self-install|self-update|self-uninstall|version-check|self-management)
                if [ "${COMMAND}" = "menu" ] || [ "${COMMAND}" = "main" ]; then
                    if [ -z "${_menu_pick}" ]; then
                        _menu_pick="$1"
                    elif [ -z "${_domain_arg}" ]; then
                        _domain_arg="$1"
                    elif [ -z "${_domain_arg2}" ]; then
                        _domain_arg2="$1"
                    else
                        out_die "Unexpected argument: $1. See '${APP_NAME} help'."
                    fi
                else
                    COMMAND="$1"
                fi
                ;;
            *)
                if [ "${COMMAND}" = "backup" ] || [ "${COMMAND}" = "print-sudoers" ] \
                    || [ "${COMMAND}" = "print-sudoers-install-script" ] \
                    || [ "${COMMAND}" = "remove-project-sudoers" ] \
                    || [ "${COMMAND}" = "generate-sudoer-request" ] \
                    || [ "${COMMAND}" = "submit-sudoer-request" ]; then
                    if [ -z "${_domain_arg}" ]; then
                        _domain_arg="$1"
                    else
                        out_die "Unexpected argument: $1. See '${APP_NAME} help'."
                    fi
                elif [ "${COMMAND}" = "restore" ]; then
                    if [ -z "${_domain_arg}" ]; then
                        _domain_arg="$1"
                    elif [ -z "${_domain_arg2}" ]; then
                        _domain_arg2="$1"
                    else
                        out_die "Unexpected argument: $1. See '${APP_NAME} help'."
                    fi
                elif [ "${COMMAND}" = "menu" ] || [ "${COMMAND}" = "main" ]; then
                    if [ -z "${_menu_pick}" ]; then
                        _menu_pick="$1"
                    elif [ -z "${_domain_arg}" ]; then
                        _domain_arg="$1"
                    elif [ -z "${_domain_arg2}" ]; then
                        _domain_arg2="$1"
                    else
                        out_die "Unexpected argument: $1. See '${APP_NAME} help'."
                    fi
                else
                    out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                fi
                ;;
        esac
        shift
    done

    # Zero-cli-verb after switches. --debug / --force are not a verb.
    # --quiet / --json with no verb are non-interactive (CLI self-install).
    # requirement-shell-cli-zero-arguments.md
    if [ -z "${COMMAND}" ]; then
        if [ "${TTY}" -eq 1 ] && [ "${JSON}" -eq 0 ] && [ "${QUIET}" -eq 0 ]; then
            app_cmd_menu
            return $?
        fi
        inst_self_install
        return $?
    fi

    out_debug "dispatch command=${COMMAND} quiet=${QUIET} json=${JSON} force=${FORCE} force_global=${FORCE_GLOBAL} allow_test_local=${ALLOW_TEST_LOCAL_SUDOERS} restore_host=${RESTORE_HOST:-}"

    case "${COMMAND}" in
        version)      app_version ;;
        about)        app_about ;;
        install)      inst_local_install ;;
        uninstall)    inst_local_uninstall ;;
        where-is-me)  app_where_is_me ;;
        self-install) inst_self_install ;;
        self-update)  inst_self_update ;;
        self-uninstall) inst_self_uninstall ;;
        version-check) ver_check ;;
        self-management)
            app_default_self_loop
            ;;
        backup)       fb_backup "${_domain_arg}" ;;
        restore)      fb_restore "${_domain_arg}" "${_domain_arg2}" ;;
        print-sudoers) fb_print_sudoers "${_domain_arg}" ;;
        print-sudoers-install-script) fb_print_sudoers_install_script "${_domain_arg}" ;;
        remove-project-sudoers) fb_remove_project_sudoers "${_domain_arg}" ;;
        generate-sudoer-request) fb_generate_sudoer_request "${_domain_arg}" ;;
        submit-sudoer-request) fb_submit_sudoer_request "${_domain_arg}" ;;
        menu|main)    app_cmd_menu "${_menu_pick}" "${_domain_arg}" "${_domain_arg2}" ;;
        help|*)       app_help ;;
    esac
}

