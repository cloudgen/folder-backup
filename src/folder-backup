# =============================================================================
# util_resolve_storage() - Cache folder resolver
# =============================================================================
#
# GENERAL PURPOSE:
# Return the best available cache directory for scratch files.
# Linux: shm leaf, then /tmp leaf, then ${HOME}/.cache leaf.
# Git Bash: /tmp leaf, then AppData Local Temp leaf.
# Mac: /tmp leaf, then Library/Caches leaf, then ${HOME}/cache leaf.
# Volatile leaves are cache-${APP_NAME}-${login}-$$. Home leaves omit login.
# A missed tier is silent (no warning, no error). Error only if every tier fails.
# MUST NOT use /dev/shm/${APP_NAME} or /dev/shm/${APP_NAME}-${USERNAME}.
#
# CIAO PRINCIPLES APPLIED:
# - Caution: two logins must not share one cache leaf.
# - Intentional: the directory name carries this process id; files inside use mktemp.
# - Anti-fragile: a missing higher tier is skipped with no message.
# - Over-protect: fail only when every tier for this host failed.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# Designed to be reusable in other projects.
#
# ECHO EXCEPTION (class B – function return-via-stdout):
# echo of cache paths is a data return for $(util_resolve_storage) capture,
# not a product user message. Failures use out_die.
# See requirement-shell-output-requirements.md §2.1.1.
#
# Lessons Learned (CIAO Reflection):
# 2026-07-13: STORAGE_DIR was bare/unset on third fallback (INC-20260713-001 P1).
# 2026-07-16: Create chosen tier root before echo (fail-closed). SM-STOR-01.
# 2026-09-27: Leaf is cache-${APP_NAME}-${login}-$$ under cache/. Tier misses
#             stay silent. Home tiers omit the login segment.
#
# Last updated: 2026-09-27
# SSOT: requirement-shell-cli-storage.md
# =============================================================================
util_resolve_storage() {
    : "${USERNAME:=unknown}"
    : "${APP_NAME:=app}"
    : "${HOME:=/tmp}"

    _storage_candidate=""
    _cache_skip="${FOLDER_BACKUP_CACHE_SKIP:-${SELFMANAGED_CACHE_SKIP:-}}"
    if [ "${_cache_skip}" != "preferred" ]; then
        _pref=$(util_preferred_cache_dir)
        if util_cache_try_dir "${_pref}"; then
            _storage_candidate="${_pref}"
        fi
    fi
    if [ -z "${_storage_candidate}" ]; then
        _fb1=$(util_fallback_cache_dir)
        if util_cache_try_dir "${_fb1}"; then
            _storage_candidate="${_fb1}"
        fi
    fi
    if [ -z "${_storage_candidate}" ]; then
        _fb2=$(util_fallback2_cache_dir)
        if [ -n "${_fb2}" ]; then
            if util_cache_try_dir "${_fb2}"; then
                _storage_candidate="${_fb2}"
            fi
        fi
    fi
    if [ -z "${_storage_candidate}" ]; then
        out_die "Cannot create cache folder. Every cache location on this computer failed. Next: make /tmp or your home directory writable, then run ${APP_NAME} about."
    fi
    echo "${_storage_candidate}"
    unset _storage_candidate _pref _fb1 _fb2 _cache_skip
    return 0
}

# =============================================================================
# util_mktemp() - scratch file inside the cache folder
# =============================================================================
#
# GENERAL PURPOSE:
# Create a mktemp file under the cache folder. The directory name carries
# this process id. The file name must not.
#
# PRINTF EXCEPTION (class B – function return-via-stdout).
# ALIGNMENT: requirement-shell-cli-storage.md
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
#
# Last updated: 2026-09-27
# =============================================================================
util_mktemp() {
    : "${APP_NAME:=folder-backup}"
    : "${EFFECTIVE_STORAGE_DIR:=}"
    _suffix="${1:-tmp}"
    _dollar='$'
    case "${_suffix}" in
        *"${_dollar}${_dollar}"*)
            out_die "Refusing a scratch file name that contains a process id. Next: pass a suffix such as bin or sha256."
            ;;
    esac
    if [ -z "${EFFECTIVE_STORAGE_DIR}" ]; then
        EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
        export EFFECTIVE_STORAGE_DIR
    fi
    _made=""
    _made=$(mktemp "${EFFECTIVE_STORAGE_DIR}/${APP_NAME}.${_suffix}.XXXXXX" 2>/dev/null) || _made=""
    if [ -z "${_made}" ]; then
        _made=$(mktemp "${TMPDIR:-/tmp}/${APP_NAME}.${_suffix}.XXXXXX" 2>/dev/null) || _made=""
    fi
    if [ -z "${_made}" ]; then
        _made=$(mktemp 2>/dev/null) || _made=""
    fi
    printf '%s' "${_made}"
    unset _suffix _dollar _made
}

# =============================================================================
# prompt_ask() - Defensive general-purpose interactive prompt with default
# =============================================================================
#
# GENERAL PURPOSE:
# Displays a message, shows current/default values if available, and waits
# for user input. Returns the answer (or the default if user presses Enter).
# Fully respects --quiet, --json, and non-TTY environments.
# Uses the centralized output system (out_info / out_msg_n).
#
# This is the **Single Source of Truth** for all simple value prompts in the project.
#
# CIAO PRINCIPLES APPLIED:
# - Caution (Principle 1): Multiple guards prevent prompting in non-interactive contexts.
# - Intentional (Principle 2): Clear behavior for TTY vs non-TTY and quiet/JSON modes.
# - Anti-fragile (Principle 3): Works reliably across different terminals and invocation methods.
# - Over-protect (Principle 18): Trusts explicit INTERACTIVE=1 from caller when low-level TTY check is flaky.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# Past AI assistants have repeatedly broken this by using raw printf/echo + read,
# which violates the single output system, quiet/json handling, and TTY detection.
#
# WARNING — do-not-capture-read (PP-A-22):
# Call in the current shell. The answer is PROMPT_ASK_VALUE.
# MUST NOT _x=$(prompt_ask …). Stdout is the prompt, not the return.
# See requirement-shell-interactive-vs-noninteractive.md
# and requirement-shell-script-coding.md.
#
# Last updated: 2026-09-23
# =============================================================================

prompt_ask() {
    # --- Safe Variable Defaults ---
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${TTY:=0}"

    # set -u safe: missing args become empty defaults (INC-20260713-001 class)
    _pa_message="${1-}"
    _pa_default="${2-}"
    _pa_current="${3-}"
    PROMPT_ASK_VALUE="${_pa_default}"

    # Never prompt in non-interactive modes. Default stays in PROMPT_ASK_VALUE.
    if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ]; then
        unset _pa_message _pa_default _pa_current
        return 0
    fi

    # Consume TTY SSOT (measured outside functions). Do not re-test [ -t.
    if [ "${TTY:-0}" -ne 1 ]; then
        if [ "${INTERACTIVE:-0}" -ne 1 ]; then
            unset _pa_message _pa_default _pa_current
            return 0
        fi
    fi

    # Show current value if present
    if [ -n "${_pa_current}" ]; then
        out_info "Current: ${_pa_current}"
    fi

    # Show default
    if [ -n "${_pa_default}" ]; then
        out_info "Default: ${_pa_default}"
    fi

    out_msg_n "${_pa_message}: "

    _pa_answer=""
    read -r _pa_answer || true
    if [ -n "${_pa_answer}" ]; then
        PROMPT_ASK_VALUE="${_pa_answer}"
    fi
    unset _pa_message _pa_default _pa_current _pa_answer
    return 0
}

